<view class="airport-field"><view class="airport-label">{{label}} *</view><view class="airport-input-row"><input class="airport-query" value="{{query}}" placeholder="输入城市、机场名或代码" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="160"/><button class="airport-clear" wx:if="{{query}}" bindtap="clear" aria-label="清空机场">×</button></view><view wx:if="{{selectedCode}}" class="airport-selected">{{selectedCode}} · 已选择</view><view wx:if="{{open&&query}}" class="airport-suggestions"><view wx:for="{{results}}" wx:key="code" class="airport-candidate" data-code="{{item.code}}" bindtap="choose"><view class="airport-candidate-name">{{item.label}}</view><view class="airport-candidate-code">{{item.code}}{{item.icao?' / '+item.icao:''}}</view><text>选择 →</text></view><view wx:if="{{!results.length}}" class="airport-empty">未找到匹配机场，试试城市名或代码</view></view></view>
