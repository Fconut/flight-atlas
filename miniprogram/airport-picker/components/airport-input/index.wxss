:host{display:block}.airport-field{padding:22rpx 24rpx}.airport-label{font-size:23rpx;color:#7c9088;margin-bottom:10rpx}.airport-input-row{display:flex;align-items:center;gap:12rpx}.airport-query{flex:1;min-width:0;height:72rpx;font-size:31rpx;font-weight:500;color:#315c61}.airport-clear{width:50rpx;height:50rpx;line-height:48rpx;padding:0;margin:0;border:0;background:#e9efea;color:#708b80;border-radius:50%;font-size:30rpx}.airport-clear:after{border:0}.airport-selected{font-size:22rpx;color:#7c9687;margin-top:5rpx}.airport-suggestions{margin-top:14rpx;background:#fff;border:1rpx solid #cdded3;border-radius:12rpx;overflow:hidden}.airport-candidate{padding:18rpx 20rpx;display:flex;flex-wrap:wrap;gap:6rpx 12rpx;border-bottom:1rpx solid #edf2ec}.airport-candidate-name{width:100%;font-size:28rpx;color:#315c61;font-weight:500}.airport-candidate-code{font-size:22rpx;color:#869c90;flex:1}.airport-candidate text{font-size:22rpx;color:#527c6b}.airport-empty{padding:20rpx;font-size:24rpx;color:#82958d}
