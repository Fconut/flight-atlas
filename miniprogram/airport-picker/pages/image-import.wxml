<view class="page">
  <view class="heading"><view><view class="eyebrow">IMPORT FLIGHTS</view><view class="title">核对航班信息</view></view><button class="close" bindtap="close" aria-label="取消导入">×</button></view>
  <view class="hint">核对日期、航班与起降方向，补充或修正红框字段后确认导入。</view>
  <view class="source"><view class="source-heading"><view bindtap="toggleImage" role="button">{{showImage?'收起原始截图':'查看原始截图'}} {{showImage?'−':'＋'}}</view><button bindtap="choose" disabled="{{processing}}" loading="{{processing}}">{{image?'换一张':'选择图片'}}</button></view><image wx:if="{{image&&showImage}}" src="{{image}}" mode="widthFix" class="preview" bindtap="preview"/><view class="privacy">图片临时上传到微信云开发识别，处理后删除。</view></view>
  <view class="message" role="status">{{message}}</view>
  <view wx:if="{{rows.length}}" class="review-toolbar"><button bindtap="selectAll">{{allSelected?'取消全选':'选择全部'}}</button><text>{{selectedCount}} / {{rows.length}} 条已选择</text><button class="{{issuesOnly?'active':''}}" bindtap="toggleIssues">{{issuesOnly?'显示全部':'只看待修正'}}{{invalidCount?' · '+invalidCount:''}}</button></view>
  <view class="flight" id="flight-{{rowIndex}}" wx:for="{{rows}}" wx:key="_key" wx:for-item="row" wx:for-index="rowIndex" hidden="{{issuesOnly&&(!row.selected||!row.invalid)}}">
    <view class="row-heading"><view class="selection" data-index="{{rowIndex}}" bindtap="toggle" role="checkbox" aria-checked="{{row.selected}}"><text class="check {{row.selected?'checked':''}}">{{row.selected?'✓':''}}</text><text>航班 {{rowIndex+1}}</text></view><text class="state {{row.invalid?'needs-review':''}}">{{!row.selected?'不导入':row.invalid?'待修正':'可导入'}}</text></view>
    <view wx:if="{{row.selected}}" class="fields"><view class="field-row" wx:for="{{fieldGroups}}" wx:key="id" wx:for-item="group"><view wx:for="{{group.items}}" wx:key="key" class="field field-{{item.key}}"><view class="label">{{item.label}}</view>
      <picker wx:if="{{item.key==='date'}}" mode="date" value="{{row.date}}" data-index="{{rowIndex}}" data-key="date" bindchange="input"><view class="picker-input {{row.errors.date?'invalid-input':''}}">{{row.date||'选择日期'}}<text>⌄</text></view></picker>
      <picker wx:elif="{{item.key==='departureTime'}}" mode="time" value="{{row.departureTime||'00:00'}}" data-index="{{rowIndex}}" data-key="departureTime" bindchange="input"><view class="picker-input {{row.errors.departureTime?'invalid-input':''}}">{{row.departureTime||'选择起飞时间'}}<text>⌄</text></view></picker>
      <view wx:else class="input-shell {{row.errors[item.key]?'invalid-input':''}}"><input value="{{row[item.key]}}" placeholder="{{item.placeholder}}" data-index="{{rowIndex}}" data-key="{{item.key}}" bindinput="input" bindfocus="focus" maxlength="80" aria-label="{{item.label}}"/></view>
      <button wx:if="{{item.key==='departureTime'&&row.departureTime}}" class="clear-time" data-index="{{rowIndex}}" bindtap="clearTime">清除时间</button><view class="original" wx:if="{{item.key==='from'&&row.rawFrom}}">原文：{{row.rawFrom}}</view><view class="original" wx:if="{{item.key==='to'&&row.rawTo}}">原文：{{row.rawTo}}</view><view class="error" wx:if="{{row.errors[item.key]}}">{{row.errors[item.key]}}</view>
      <view wx:if="{{(item.key==='from'||item.key==='to')&&row.recommendations[item.key].length}}" class="candidates">
        <view class="candidate-heading"><text class="candidate-heading-mark">⌖</text><text>推荐机场</text><text class="candidate-heading-hint">点击选项填入</text></view>
        <button class="candidate-option" wx:for="{{row.recommendations[item.key]}}" wx:key="code" wx:for-item="airport" data-index="{{rowIndex}}" data-key="{{item.key}}" data-code="{{airport.code}}" bindtap="chooseAirport" aria-label="选择 {{airport.label}} {{airport.code}}">
          <view class="candidate-code">{{airport.code}}</view><view class="candidate-copy"><view class="candidate-name">{{airport.label}}</view><view class="candidate-reason">{{airport.kind==='fuzzy'?'名称相近，请核对':airport.kind==='city'?'该城市的机场，请确认':'匹配截图名称'}}</view></view><view class="candidate-select">选择<text>→</text></view>
        </button>
      </view>
      <block wx:if="{{item.key==='aircraft'}}"><view wx:if="{{row.rawAircraft&&row.rawAircraft!==row.aircraft}}" class="original">原文：{{row.rawAircraft}}</view><view wx:if="{{row.modelName&&row.modelName!==row.aircraft}}" class="model-recognized">对应机型：{{row.modelName}}</view><view wx:elif="{{row.modelUnmatched}}" class="original">暂未匹配到具体型号，可保留原文后导入。</view><view wx:if="{{row.modelOptions.length}}" class="candidates"><view class="candidate-heading">推荐机型 · 请核对后选择</view><button wx:for="{{row.modelOptions}}" wx:key="id" wx:for-item="model" class="candidate-option" data-index="{{rowIndex}}" data-value="{{model.name}}" bindtap="chooseModel">{{model.name}} →</button></view></block>
    </view></view></view>
  </view>
  <view wx:if="{{issuesOnly&&!invalidCount}}" class="hint">已选航班没有待修正字段，可以确认导入。</view>
  <button wx:if="{{rawText}}" class="raw-toggle" bindtap="toggleRaw">{{showRaw?'收起识别文字':'查看识别文字'}}</button><text wx:if="{{showRaw}}" class="raw" user-select="{{true}}">{{rawText}}</text>
  <view class="actions"><view class="selection-summary">{{processing?'正在识别…':(selectedCount||0)+' 条已选择'}}<text>{{invalidCount?invalidCount+' 条待修正':selectedCount?'核对无误后确认导入':''}}</text></view><button class="primary" bindtap="confirm" disabled="{{processing||!selectedCount}}">导入 {{selectedCount||0}} 条航班</button></view>
</view>