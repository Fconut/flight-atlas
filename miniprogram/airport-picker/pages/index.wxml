<view class="page"><input focus placeholder="搜索机场、城市或代码" bindinput="search"/><view wx:if="{{!query}}"><view class="hint">{{frequent.length?'常用机场':'输入机场或城市名称，点击结果选择。'}}</view><view class="airport" wx:for="{{frequent}}" wx:key="code" data-code="{{item.code}}" bindtap="choose"><view>{{item.label}}</view><text>{{item.code}}</text></view></view><view wx:if="{{query&&!results.length}}" class="hint">未找到匹配机场，试试城市名或机场代码。</view><view class="airport" wx:for="{{results}}" wx:key="code" data-code="{{item.code}}" bindtap="choose"><view>{{item.label}}</view><text>{{item.code}} {{item.icao?' / '+item.icao:''}} · {{item.city}}</text></view></view>