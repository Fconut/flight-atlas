page {
  background: #f3f5f3;
  color: #213c46;
}
.page {
  padding: 16px 12px calc(16px + env(safe-area-inset-bottom));
}
.heading {
  padding: 0 4px 14px;
}
.eyebrow {
  font-size: 9.5px;
  letter-spacing: 1.5px;
  color: #82988d;
}
.title {
  font-size: 17.5px;
  font-weight: 600;
  margin-top: 8px;
}
.map {
  width: 100%;
  height: 240px;
  border-radius: 9px;
  background: #101c2a;
  overflow: hidden;
}
.playback {
  padding: 14px;
  background: white;
  border-radius: 9px;
  margin-top: 12px;
}
.count {
  font-size: 12.5px;
  color: #315c61;
  display: flex;
  justify-content: space-between;
  margin-bottom: 13px;
}
.count > text {
  font-size: 11px;
  color: #81958e;
}
.date {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
  color: #71858a;
}
.route {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 13px 0;
  font-size: 14px;
  font-weight: 600;
}
.route > view {
  flex: 1;
  overflow-wrap: anywhere;
}
.route view text {
  display: block;
  font-size: 12px;
  color: #7e9790;
  letter-spacing: 1px;
  margin-top: 4px;
  font-weight: 400;
}
.arrival {
  text-align: right;
}
.arrow {
  color: #91a89d;
  font-size: 17px;
}
.controls {
  display: flex;
  align-items: center;
  gap: 9px;
}
.controls button {
  margin: 0;
  flex: 1;
  font-size: 12.5px;
  padding: 10px 4px;
  line-height: 1.5;
  background: #edf2ee;
  color: #315c61;
  border-radius: 6px;
}
.controls .primary {
  flex: 1.4;
  background: #244b53;
  color: white;
}
button:after {
  border: 0;
}
.note {
  font-size: 11px;
  color: #7c9189;
  line-height: 1.7;
  margin: 12px 5px;
}
.buffer {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
}
.orientation-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 10px;
}
.orientation-bar button {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  padding: 8px 14px;
  background: #e7eee9;
  color: #315c61;
  border-radius: 18px;
}
.landscape {
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  padding: 0;
  overflow: hidden;
  position: relative;
  background: #101c2a;
}
.landscape .heading {
  display: none;
}
.landscape .map {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw !important;
  height: 100vh !important;
  border-radius: 0;
  z-index: 0;
}
.landscape .note {
  position: absolute;
  left: 20%;
  right: 20%;
  top: 40%;
  font-size: 14px;
  color: white;
  text-align: center;
}
