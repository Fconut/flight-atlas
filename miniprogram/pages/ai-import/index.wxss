page{background:#f3f5f3;color:#213c46}.guide{padding:36rpx 32rpx 190rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#7b9290}.title{font-size:40rpx;font-weight:700;margin-top:18rpx}.intro{font-size:25rpx;color:#71858a;line-height:1.7;margin-top:16rpx}.steps{padding:30rpx;background:white;border-radius:20rpx;margin:32rpx 0}.step{display:flex;gap:22rpx;align-items:flex-start;margin-bottom:28rpx}.step:last-child{margin-bottom:0}.number{background:#e9f0eb;color:#315c61;width:46rpx;line-height:46rpx;text-align:center;border-radius:50%;flex:none;font-size:25rpx}.step-title{font-size:28rpx;font-weight:600}.note{font-size:23rpx;color:#7b8f90;margin-top:8rpx;line-height:1.6}.prompt-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:18rpx;font-size:29rpx;font-weight:600}.prompt{display:block;white-space:pre-wrap;font-size:25rpx;line-height:1.9;padding:28rpx;background:white;border-radius:18rpx;color:#456168}.footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:18rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:white;border-top:1rpx solid #e3eae5}.footer button{flex:1;margin:0;font-size:27rpx;line-height:1.5;padding:24rpx 10rpx;border-radius:12rpx}.primary{background:#193f48;color:white}.secondary{background:#edf2ee;color:#315c61}button:after{border:0}