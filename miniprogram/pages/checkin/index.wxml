<view class="checkin-page">
  <view class="page-heading"><view class="eyebrow">DAILY COLLECTION</view><view class="title">把日常，收进旅程。</view></view>
  <view class="checkin-summary"><view class="summary-count"><view class="summary-label">累计签到</view><view class="progress"><text class="days">{{loaded?days:'—'}}</text><text class="day-unit">天</text></view></view><button class="sign summary-action {{signedToday?'signed':''}}" bindtap="sign" disabled="{{busy||!loaded||signedToday}}" loading="{{busy||(!loaded&&refreshing)}}">{{!loaded?'正在读取':signedToday?'✓ 今日已签到':'今日签到'}}</button></view>
  <view class="error" wx:if="{{error&&!selectedReward}}" role="alert">{{error}}<button bindtap="retry" disabled="{{busy||refreshing}}">重试</button></view>
  <view class="calendar-heading">签到奖励</view>
  <view class="reward-calendar">
    <view wx:for="{{calendar}}" wx:key="day" data-day="{{item.day}}" bindtap="openReward" role="{{item.reward?'button':'text'}}" aria-label="{{item.reward?'累计签到'+item.day+'天，'+item.reward.name+'，'+(item.completed?'可领取':'查看奖励'):'累计签到'+item.day+'天'}}" class="calendar-day {{item.completed?'completed':''}} {{item.reward?'has-reward':''}} {{item.reward&&item.completed?'claimable':''}}">
      <text class="day-number">{{item.day}}</text>
      <view wx:if="{{item.reward}}" class="calendar-map {{item.reward.type==='stamp'?'calendar-stamp':''}}" style="background:{{item.reward.type==='stamp'?'#f6f3e9':item.reward.colors.background}}"><image src="{{item.reward.sheet}}" style="left:-{{item.reward.column*100}}%;top:-{{item.reward.row*100}}%" mode="scaleToFill"/></view>
      <text wx:if="{{item.reward}}" class="calendar-name">{{item.reward.name}}</text>
      <view wx:if="{{item.reward&&item.completed}}" class="calendar-claim">领取 <text>›</text></view>
      <view wx:if="{{!item.reward}}" class="day-mark"/>
    </view>
  </view>
</view>

<view wx:if="{{selectedReward}}" class="reward-overlay" bindtap="closeReward"><view class="reward-dialog" catchtap="stop"><view class="dialog-heading">累计 {{selectedReward.day}} 天奖励<button bindtap="closeReward" disabled="{{busy}}" aria-label="关闭">×</button></view><view wx:if="{{selectedReward.reward.type==='stamp'}}" class="stamp-reward-art"><stamp-preview0 wx:if="{{selectedReward.reward.previewPackage==='stamps0'}}" stamp-id="{{selectedReward.reward.id}}" bindfailed="rewardArtError"/><stamp-preview1 wx:elif="{{selectedReward.reward.previewPackage==='stamps1'}}" stamp-id="{{selectedReward.reward.id}}" bindfailed="rewardArtError"/><stamp-preview2 wx:elif="{{selectedReward.reward.previewPackage==='stamps2'}}" stamp-id="{{selectedReward.reward.id}}" bindfailed="rewardArtError"/><stamp-preview3 wx:else stamp-id="{{selectedReward.reward.id}}" bindfailed="rewardArtError"/></view><view wx:else class="dialog-map"><image src="/assets/collection/palettes.jpg" style="left:-{{selectedReward.reward.column*100}}%;top:-{{selectedReward.reward.row*100}}%" mode="scaleToFill"/></view><view class="dialog-name">{{selectedReward.reward.name}}</view><view class="dialog-description">{{selectedReward.reward.description}}</view><button class="sign" bindtap="claim" loading="{{busy}}" disabled="{{busy||!selectedReward.completed||selectedReward.label==='已领取'}}">{{selectedReward.label==='已领取'?'已领取':selectedReward.completed?'领取奖励':'累计签到 '+selectedReward.day+' 天可领取'}}</button><view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view></view>

<view wx:if="{{claimedReward}}" class="reward-overlay" bindtap="closeReward"><view class="reward-dialog claim-success" catchtap="stop" role="status"><view class="success-check">✓</view><view class="success-title">领取成功</view><view wx:if="{{claimedReward.type==='stamp'}}" class="stamp-reward-art"><stamp-preview0 wx:if="{{claimedReward.previewPackage==='stamps0'}}" stamp-id="{{claimedReward.id}}" bindfailed="rewardArtError"/><stamp-preview1 wx:elif="{{claimedReward.previewPackage==='stamps1'}}" stamp-id="{{claimedReward.id}}" bindfailed="rewardArtError"/><stamp-preview2 wx:elif="{{claimedReward.previewPackage==='stamps2'}}" stamp-id="{{claimedReward.id}}" bindfailed="rewardArtError"/><stamp-preview3 wx:else stamp-id="{{claimedReward.id}}" bindfailed="rewardArtError"/></view><view wx:else class="dialog-map"><image src="/assets/collection/palettes.jpg" style="left:-{{claimedReward.column*100}}%;top:-{{claimedReward.row*100}}%" mode="scaleToFill"/></view><view class="dialog-name">{{claimedReward.name}}</view><view class="dialog-description">已收入收藏</view><button wx:if="{{claimedReward.id}}" class="sign" bindtap="viewClaimedReward">去看看</button><button class="secondary" bindtap="closeReward">完成</button><view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view></view>
