page{background:#f4f5f3;color:#213c46}.page{padding:32rpx 26rpx calc(160rpx + env(safe-area-inset-bottom))}.title{font-size:38rpx;font-weight:500;margin:16rpx 0 32rpx}.card{width:100%;border-radius:20rpx;background:#fff}.message{font-size:25rpx;color:#71858a;line-height:1.7;margin:24rpx 0}.actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;background:#f4f5f3;border-top:1rpx solid #dfe6df}button{font-size:27rpx;background:#fff;color:#315c61}.actions button{flex:1;margin:0}.primary{background:#315c61;color:#fff}.actions button[disabled]{background:#e2e8e2;color:#96a49c}.hidden-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;opacity:0;pointer-events:none}





.asset-preload{position:fixed;left:-10000px;top:0;width:320rpx;height:230rpx;opacity:0;pointer-events:none}
