<view class="page"><view class="title">{{shareHeading||'准备分享'}}</view><view wx:if="{{loading||imageLoading}}" class="message">{{stage||'正在准备图片…'}}</view><image wx:if="{{plainPath||posterPath}}" src="{{ready?posterPath:plainPath}}" class="card" mode="widthFix" bindtap="preview"/><view wx:if="{{message}}" class="message" role="status">{{message}}</view><button wx:if="{{!plainPath&&!loading}}" bindtap="render">重新生成图片</button><view class="actions"><button wx:if="{{!ready}}" class="primary" bindtap="prepareImage" disabled="{{loading||imageLoading||!plainPath}}" loading="{{imageLoading}}">生成分享卡片</button><block wx:else><button bindtap="shareImage">分享图片</button><button class="primary" open-type="share">分享卡片</button></block></view></view><canvas wx:if="{{rendering}}" type="2d" id="badge-card" class="hidden-canvas"/><canvas wx:if="{{rendering}}" type="2d" id="collection-card" class="hidden-canvas"/><canvas wx:if="{{posterRendering}}" type="2d" id="collection-poster" class="hidden-canvas"/><view class="asset-preload" aria-hidden="true"><block wx:for="{{assetLoaders}}" wx:key="package"><badge-art0 wx:if="{{item.package==='badges0'}}" src="{{item.badge}}" data-package="{{item.package}}" bindassetready="assetLoaded" bindasseterror="assetFailed"/><badge-art1 wx:if="{{item.package==='badges1'}}" src="{{item.badge}}" data-package="{{item.package}}" bindassetready="assetLoaded" bindasseterror="assetFailed"/><badge-art2 wx:if="{{item.package==='badges2'}}" src="{{item.badge}}" data-package="{{item.package}}" bindassetready="assetLoaded" bindasseterror="assetFailed"/><badge-art3 wx:if="{{item.package==='badges3'}}" src="{{item.badge}}" data-package="{{item.package}}" bindassetready="assetLoaded" bindasseterror="assetFailed"/><badge-art4 wx:if="{{item.package==='badges4'}}" src="{{item.badge}}" data-package="{{item.package}}" bindassetready="assetLoaded" bindasseterror="assetFailed"/></block></view>