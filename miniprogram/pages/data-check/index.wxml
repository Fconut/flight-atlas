<view wx:if="{{initializing}}" class="notice">正在检查记录…</view><view wx:else class="page">
  <view class="eyebrow">FLIGHT DATA CHECK</view><view class="title">让每一程，更完整。</view>
  <view class="summary">{{qualityReady?(qualityTotal?'有 '+qualityTotal+' 条记录待核对':'暂未发现需核对或完善的记录'):(error?'暂时无法读取记录':'正在读取记录…')}}<view wx:if="{{qualityReady}}">已检查 {{qualityChecked||0}} 条记录 · 同一条记录可能有多项问题</view></view>
  <view wx:if="{{savePhase==='offline'||savePhase==='error'}}" class="notice">{{saveStatusText}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="tabs"><view wx:for="{{qualityTabs}}" wx:key="key" class="tab {{qualityFilter===item.key?'active':''}}" data-key="{{item.key}}" bindtap="selectQualityFilter"><view>{{item.label}}</view><text>{{item.count}}</text></view></view>
  <view class="note">{{qualityNote}}</view>
  <view class="card" wx:for="{{qualityItems}}" wx:key="id">
    <view class="card-heading"><text>{{item.date}} {{item.time}}</text><text>{{item.flight}}</text></view>
    <view class="route">{{item.fromName}} → {{item.toName}}</view><view class="codes">{{item.from}} → {{item.to}}</view>
    <view class="reasons"><view class="reason error-reason" wx:for="{{item.errors}}" wx:for-item="reason" wx:key="*this">{{reason}}</view><view wx:if="{{item.missing}}" class="reason">尚未填写机型 · 选填</view><view wx:if="{{item.unmatched}}" class="reason">未匹配到机型：{{item.aircraft}}<view class="model-hint">可保留原文，不影响航班保存与统计</view></view><view class="reason duplicate-reason" wx:for="{{item.duplicateNotes}}" wx:for-item="reason" wx:key="*this">{{reason}}</view></view>
    <view wx:if="{{modelTarget===item.id}}" class="model-inline"><view wx:if="{{modelBefore}}" class="model-original">原文：{{modelBefore}}</view><input value="{{modelQuery}}" placeholder="搜索机型，如 737、A350、空客" maxlength="100" bindinput="modelInput" cursor-spacing="160"/><view wx:if="{{modelSuggestions.length}}" class="model-candidates"><view class="model-candidates-heading"><text>推荐机型</text><text class="model-candidates-hint">点击选项填入</text></view><button class="model-option" wx:for="{{modelSuggestions}}" wx:for-item="model" wx:key="id" data-value="{{model.name}}" bindtap="pickModel" aria-label="选择 {{model.name}}"><text class="model-option-name">{{model.name}}</text><text class="model-option-action">选择 →</text></button><view class="model-candidates-note">请按实际乘坐型号选择</view></view><view wx:if="{{modelBefore&&modelQuery!==modelBefore}}" class="model-change">已填入：{{modelQuery}} · 保存后生效</view><view wx:if="{{modelError}}" class="error">{{modelError}}</view><view class="card-actions"><button bindtap="cancelModel">取消</button><button class="edit" bindtap="saveModel">保存机型</button></view></view><view class="card-actions"><button wx:if="{{(item.missing||item.unmatched)&&modelTarget!==item.id}}" class="edit" data-id="{{item.id}}" bindtap="startModel">{{item.missing?'补齐机型':'选择机型'}}</button><button wx:if="{{item.duplicate}}" class="delete" data-id="{{item.id}}" bindtap="deleteQualityFlight">删除记录</button><button wx:if="{{modelTarget!==item.id}}" class="edit" data-id="{{item.id}}" bindtap="editQualityFlight">查看与修正 →</button></view>
  </view>
  <view wx:if="{{qualityReady&&!qualityItems.length}}" class="empty">{{!rows.length?'还没有航班记录，添加后可在这里检查。':qualityTotal?'这个分类暂时没有需要核对的记录':'继续记录下一段旅程吧。'}}</view>
  <button wx:if="{{canUndo}}" bindtap="undoRemove">撤销删除</button><view wx:if="{{qualityPages>1}}" class="pagination"><button data-step="-1" bindtap="turnQualityPage" disabled="{{qualityPage<=1}}">上一页</button><text>{{qualityPage}} / {{qualityPages}}</text><button data-step="1" bindtap="turnQualityPage" disabled="{{qualityPage>=qualityPages}}">下一页</button></view>
</view>
