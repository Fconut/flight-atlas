page{background:#f4f5f3;color:#213c46;font-size:26rpx}.page{padding:28rpx 26rpx 40rpx}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#9c8353}.title{font-size:38rpx;font-weight:500;margin:14rpx 0 22rpx}.summary{font-size:28rpx;font-weight:600}.summary>view{font-size:21rpx;font-weight:400;color:#82938e;line-height:1.7;margin-top:10rpx}.tabs{display:flex;background:#eaf0e9;border-radius:16rpx;padding:8rpx;margin-top:26rpx}.tab{flex:1;text-align:center;padding:14rpx 4rpx;font-size:23rpx;color:#82938e;border-radius:12rpx}.tab text{display:block;margin-top:6rpx;font-size:28rpx;font-weight:600}.active{background:#fff;color:#315c61}.note{font-size:22rpx;color:#82938e;line-height:1.7;margin:18rpx 0 24rpx}.card{background:#fff;border:1rpx solid #dfe5e1;border-radius:18rpx;padding:24rpx;margin-top:20rpx}.card-heading{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10rpx;color:#82938e;font-size:22rpx}.card-heading text:last-child{color:#426168;font-weight:500}.route{font-size:28rpx;font-weight:500;line-height:1.6;margin-top:16rpx;overflow-wrap:anywhere}.codes{font-size:22rpx;letter-spacing:1rpx;color:#91a098;margin-top:4rpx}.reasons{margin-top:20rpx;padding:16rpx 18rpx;background:#f4f7f2;border-radius:10rpx}.reason{font-size:22rpx;color:#718777;line-height:1.7}.error-reason{color:#ad6450}.duplicate-reason{color:#947a4e}.reason+.reason{margin-top:8rpx}.card-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:20rpx}button{font-size:23rpx;padding:16rpx 22rpx;line-height:1.5;margin:0;border-radius:10rpx;background:#edf2ed;color:#446e70}button:after{border:0}.card-actions .delete{background:transparent;color:#a16959}.card-actions .edit{background:#e8f0e9;color:#315c61}.empty{text-align:center;padding:60rpx 12rpx;font-size:25rpx;color:#82938e}.pagination{display:flex;align-items:center;justify-content:space-between;margin-top:26rpx;color:#82938e;font-size:23rpx}.error,.notice{font-size:23rpx;color:#a16959;line-height:1.7;margin-top:18rpx}

.page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}

.model-inline{margin-top:20rpx;padding:20rpx;background:#f2f6f0;border-radius:12rpx}.model-inline input{height:80rpx;font-size:27rpx;background:white;padding:0 18rpx;border:1rpx solid #cdddcf;border-radius:10rpx}.model-option{padding:20rpx 12rpx;border-bottom:1rpx solid #dce6da;color:#315c61;font-size:26rpx}

.model-hint,.model-caption{font-size:21rpx;color:#82938e;margin-top:8rpx}.model-original,.model-change{font-size:23rpx;color:#426168;line-height:1.7;overflow-wrap:anywhere;margin:0 0 14rpx}.model-change{margin-top:18rpx}.model-option{background:#fff;border:1rpx solid #dce6da;border-radius:10rpx;margin-top:10rpx}

.model-candidates{margin-top:22rpx;padding:20rpx;border-left:5rpx solid #71988a;background:#e5eeE7;border-radius:12rpx}.model-candidates-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#315c61;font-size:25rpx;font-weight:600}.model-candidates-hint{font-size:21rpx;color:#69867b;font-weight:400}.model-candidates .model-option{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;box-sizing:border-box;margin:16rpx 0 0;padding:24rpx 20rpx;line-height:1.5;text-align:left;background:#fff;border:2rpx solid #b8d0c1;border-radius:12rpx}.model-option:after{border:0}.model-option-name{font-size:27rpx;font-weight:600;color:#294c54}.model-option-action{flex:none;font-size:23rpx;color:#456f5f;background:#eef4ef;padding:6rpx 14rpx;border-radius:8rpx}.model-candidates-note{font-size:21rpx;color:#718a80;margin-top:14rpx}.model-change{color:#315c61;font-weight:600}
