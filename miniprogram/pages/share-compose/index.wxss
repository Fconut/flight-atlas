page{background:#f4f5f3;color:#213c46;font-size:26rpx}.page{padding:28rpx 26rpx calc(40rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#9c8353}.title{font-size:36rpx;font-weight:500;margin:16rpx 0}.note{font-size:22rpx;line-height:1.8;color:#82938e;margin:12rpx 0}.poster{width:100%;border-radius:16rpx;margin-top:18rpx}.message{font-size:24rpx;line-height:1.7;color:#57766c;margin:16rpx 0}.buttons{display:flex;gap:16rpx;margin-top:20rpx}.buttons button{flex:1}button{margin:0;padding:24rpx 16rpx;font-size:25rpx;line-height:1.5;background:#eaf0e9;color:#446e70;border-radius:12rpx}button:after{border:0}.primary{background:#254c43;color:#fff}.hidden-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;opacity:0;pointer-events:none}
