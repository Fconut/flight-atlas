<view class="page"><view class="eyebrow">SHARE YOUR JOURNEYS</view><view class="title">把你的足迹，分享出去。</view><view wx:if="{{loading}}" class="message">正在生成足迹预览…</view><image wx:if="{{posterPath}}" class="poster" src="{{posterPath}}" mode="widthFix" bindtap="preview"/><view class="message" role="status">{{message}}</view><view class="buttons"><button wx:if="{{!ready}}" class="primary" bindtap="createShare" disabled="{{loading||busy||!posterPath}}" loading="{{busy}}">生成分享卡片</button><block wx:else><button bindtap="shareImage" disabled="{{busy}}">分享图片</button><button class="primary" open-type="share" disabled="{{busy}}">分享卡片</button></block></view></view><canvas wx:if="{{rendering}}" type="2d" id="share-poster" class="hidden-canvas"/><canvas wx:if="{{rendering}}" type="2d" id="share-card" class="hidden-canvas"/>
