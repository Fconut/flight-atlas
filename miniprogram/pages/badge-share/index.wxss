page{background:#fff;color:#213c46;font-size:26rpx}
.page{padding:24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom))}
.badge-header{display:flex;align-items:center;gap:16rpx;padding:6rpx 0 22rpx}.badge-thumbnail{width:96rpx;height:96rpx;flex:none}.badge-heading-copy{flex:1;min-width:0}.title{font-size:32rpx;font-weight:600;line-height:1.35;overflow-wrap:anywhere}.first-date{margin-top:10rpx;color:#82958c;font-size:20rpx;line-height:1.4}
.stats{display:flex;padding:16rpx 0 24rpx;border-bottom:1rpx solid #e5ece5}.stats>view{flex:1;min-width:0;text-align:center;font-size:20rpx;color:#82948c}.stats>view+view{border-left:1rpx solid #e6ece5}.stats text{display:block}.stats .number{font-size:36rpx;font-weight:600;color:#31575d;line-height:1.2;margin-bottom:8rpx}
.list-heading{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0 16rpx;font-size:26rpx;font-weight:600}.sort-note{font-size:20rpx;font-weight:400;color:#91a098}.selection-bar{display:flex;align-items:center;justify-content:space-between;font-size:21rpx;color:#829790;padding:0 0 14rpx}.selection-bar button{margin:0;padding:8rpx 18rpx;line-height:1.6;font-size:22rpx;background:#f0f5ef;color:#527b75;border-radius:8rpx}
.record{padding:24rpx 20rpx;border-bottom:1rpx solid #e5ece5}.record-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.record-date-group{display:flex;align-items:center;gap:12rpx;min-width:0}.date{font-size:21rpx;color:#80928c;line-height:1.5;overflow-wrap:anywhere}.flight{display:flex;align-items:center;flex:none;font-size:23rpx;color:#426168;font-weight:500}.route{display:flex;gap:20rpx;align-items:center;margin-top:18rpx}.airport{flex:1;min-width:0}.airport-name{font-size:28rpx;font-weight:600;line-height:1.45;overflow-wrap:anywhere}.arrival{text-align:right}.code{display:block;color:#8a9d98;font-size:21rpx;letter-spacing:1.5rpx;margin-top:5rpx}.arrow{color:#a5b6ae;font-size:28rpx;flex:none}.check{box-sizing:border-box;width:32rpx;height:32rpx;line-height:28rpx;text-align:center;border:2rpx solid #cad7d0;border-radius:7rpx;color:#fff;font-size:23rpx;flex:none}.checked{background:#315c61;border-color:#315c61}.unselected .date,.unselected .flight,.unselected .route{opacity:.5}
.loading{padding:24rpx 0;color:#82958c;font-size:24rpx}button{background:#315c61;color:#fff;font-size:27rpx}button:after{border:0}.retry{margin-top:24rpx}.share-actions{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e0e8e1;z-index:10}.share-actions button{flex:1;margin:0;border-radius:12rpx}.share-actions button[disabled]{background:#e4ebe5;color:#96a49c}
.message{position:fixed;left:26rpx;right:26rpx;bottom:calc(126rpx + env(safe-area-inset-bottom));z-index:20;padding:20rpx 24rpx;background:#fff5e9;border:1rpx solid #ead8bf;border-radius:12rpx;color:#8d6038;font-size:25rpx;line-height:1.6;box-shadow:0 6rpx 22rpx rgba(38,62,52,.08)}
