<view class="page">
  <view wx:if="{{badge}}" class="badge-header"><view class="badge-thumbnail"><badge-art0 wx:if="{{badge.package==='badges0'}}" src="{{badge.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art1 wx:if="{{badge.package==='badges1'}}" src="{{badge.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art2 wx:if="{{badge.package==='badges2'}}" src="{{badge.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art3 wx:if="{{badge.package==='badges3'}}" src="{{badge.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art4 wx:if="{{badge.package==='badges4'}}" src="{{badge.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/></view><view class="badge-heading-copy"><view class="title">{{badge.name}}</view><view class="first-date">{{firstDate?'最早记录 '+firstDate:(loading?'正在加载记录…':'尚未选择记录')}}</view></view></view>
  <view wx:if="{{stats}}" class="stats"><view><text class="number">{{stats.total}}</text><text>次飞行{{public?'':'（已选）'}}</text></view><view><text class="number">{{stats.airlines}}</text><text>家航空公司</text></view><view><text class="number">{{stats.routes}}</text><text>条单向航线</text></view></view>
  <view wx:if="{{loading}}" class="loading" role="status">正在准备…</view>
  <view wx:if="{{records.length}}" class="list-heading"><text>{{public?'乘坐记录':'选择乘坐记录'}}</text><text class="sort-note">最新在前</text></view>
  <view wx:if="{{records.length&&!public}}" class="selection-bar"><text>已选 {{selectedCount}} / {{records.length}}</text><button bindtap="selectAll" disabled="{{busy}}">{{selectedCount===records.length?'取消全选':'全选'}}</button></view>
  <view class="record {{!public&&!item.selected?'unselected':''}}" style="background:{{item.cardTheme.background}}" role="{{public?'listitem':'checkbox'}}" aria-checked="{{item.selected}}" wx:for="{{records}}" wx:key="index" data-index="{{index}}" bindtap="toggle">
    <view class="record-top"><view class="record-date-group"><text wx:if="{{!public}}" class="check {{item.selected?'checked':''}}">{{item.selected?'✓':''}}</text><text class="date">{{item.date}} {{item.departureTime}}</text></view><view class="flight"><airline-logo code="{{item.airline}}" flight="{{item.flight}}"/></view></view>
    <view class="route"><view class="airport"><view class="airport-name">{{item.fromName}}</view><text class="code">{{item.from}}</text></view><text class="arrow">→</text><view class="airport arrival"><view class="airport-name">{{item.toName}}</view><text class="code">{{item.to}}</text></view></view>
  </view>
  <view wx:if="{{message}}" class="message" role="alert">{{message}}</view><button wx:if="{{loadError}}" class="retry" bindtap="load">重新加载</button>
  <view wx:if="{{badge&&!loadError}}" class="share-actions"><button wx:if="{{!public}}" bindtap="prepare" loading="{{busy}}" disabled="{{busy||loading||!selectedCount}}">{{selectedCount?'准备分享 · '+selectedCount+' 条':'请选择航班'}}</button><button wx:if="{{public}}" bindtap="makeMine">制作我的徽章 →</button></view>
</view>
