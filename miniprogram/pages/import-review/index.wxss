page{background:#f3f5f3;color:#213c46}.page{padding:32rpx 28rpx 180rpx}.title{font-size:38rpx;font-weight:700}.filename{font-size:23rpx;color:#7b8f90;margin:14rpx 0;overflow-wrap:anywhere}.summary{font-size:27rpx;color:#315c61;margin:26rpx 0}.tabs{display:flex;background:#e9efeb;border-radius:12rpx;margin:26rpx 0;padding:6rpx}.tab{flex:1;text-align:center;padding:20rpx 4rpx;font-size:26rpx;color:#758b87}.active{background:white;color:#244b53;font-weight:600;border-radius:9rpx}.note{font-size:23rpx;color:#71858a;line-height:1.7;margin:14rpx 0}.card{background:white;padding:26rpx;border:1rpx solid #e0e8e2;border-radius:16rpx;margin-top:20rpx}.meta{display:flex;justify-content:space-between;gap:16rpx;font-size:23rpx;color:#71858a}.route{font-size:28rpx;font-weight:600;margin-top:20rpx;line-height:1.6}.code{font-size:23rpx;color:#7e9591;margin-top:6rpx}.change{border-top:1rpx solid #e8eeea;margin-top:20rpx;padding-top:16rpx;font-size:24rpx;line-height:1.8}.before{color:#899894}.after{color:#315c61;font-weight:600}.empty{text-align:center;color:#849691;padding:70rpx 0;font-size:26rpx}.more{margin-top:24rpx;font-size:25rpx;background:#e8efea;color:#315c61}.footer{position:fixed;left:0;right:0;bottom:0;background:white;border-top:1rpx solid #e0e8e2;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx}.footer button{margin:0;flex:1;padding:24rpx 8rpx;font-size:26rpx;line-height:1.5;border-radius:12rpx;background:#edf2ee;color:#315c61}.footer .primary{flex:2;background:#193f48;color:white}button:after{border:0}
.selection{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;font-size:24rpx;color:#657f7a}.selection button{margin:0;padding:10rpx 18rpx;font-size:23rpx;line-height:1.5;background:#e5ede7;color:#315c61}.pick{display:flex;align-items:center;gap:12rpx;font-size:23rpx;color:#607f75;margin-bottom:20rpx}.pick-box{display:block;width:32rpx;height:32rpx;line-height:32rpx;text-align:center;border:2rpx solid #b7c9bf;border-radius:6rpx}.checked{background:#315c61;color:white;border-color:#315c61}.unselected{background:#eef1ee;border-color:#dce3de}.footer .primary[disabled]{background:#b6c4bf;color:white}
