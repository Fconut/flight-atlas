<view class="page"><view class="title">核对这次导入</view><view wx:if="{{reviewError}}" class="note" role="alert">{{reviewError}}</view><view class="filename">{{name}}</view><view class="summary">新增 {{added}} 条 · 更新 {{updated}} 条 · 跳过重复 {{skipped}} 条</view><view wx:if="{{withinFile}}" class="note">文件内重复 {{withinFile}} 条已合并；下方每个航班只展示一次。</view><view class="tabs"><view wx:for="{{['added','updated','duplicate']}}" wx:key="*this" data-key="{{item}}" bindtap="select" class="tab {{tab===item?'active':''}}">{{item==='added'?'新增':item==='updated'?'更新':'重复'}} {{groups[item].length||0}}</view></view><view class="note">{{tab==='added'?'勾选要加入的航班，未勾选的不会导入':tab==='updated'?'仅更新非空的机型与起飞时间，其他信息保留':'与已有记录相同，无需再次保存'}}</view><view wx:if="{{tab!=='duplicate'&&groups[tab].length}}" class="selection"><text>本类已选 {{groupSelected}} / {{groups[tab].length}}</text><button bindtap="toggleAll">{{groupSelected===groups[tab].length?'取消全选':'全选本类'}}</button></view><view class="card {{tab!=='duplicate'&&!item.selected?'unselected':''}}" wx:for="{{visible}}" wx:key="index" data-id="{{item.reviewId}}" bindtap="toggle" role="{{tab==='duplicate'?'listitem':'checkbox'}}" aria-checked="{{item.selected}}"><view wx:if="{{tab!=='duplicate'}}" class="pick"><text class="pick-box {{item.selected?'checked':''}}">{{item.selected?'✓':''}}</text><text>{{item.selected?'已选择':'不导入'}}</text></view><view class="meta">{{item.date}} {{item.departureTime}}<text>{{item.flight}}</text></view><view class="route">{{item.fromName}} → {{item.toName}}</view><view class="code">{{item.from}} → {{item.to}}</view><view wx:if="{{tab==='added'}}" class="note">{{item.aircraft}}</view><view class="change" wx:for="{{item.changes}}" wx:for-item="change" wx:key="field"><view>{{change.label}}</view><view class="before">{{change.before}}</view><view class="after">→ {{change.after}}</view></view></view><view wx:if="{{ready&&!visible.length}}" class="empty">没有这类记录</view><button wx:if="{{remaining}}" class="more" bindtap="more">再显示 {{remaining>30?30:remaining}} 条</button></view><view class="footer"><button bindtap="cancel">返回</button><button class="primary" bindtap="confirm" disabled="{{!ready||((added||updated)&&!selectedCount)}}">{{added||updated?'确认导入 '+selectedCount+' 条':'完成 · 无需更新'}}</button></view>