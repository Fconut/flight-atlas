page {
  background: #f4f5f3;
  color: #213e48;
}
.shelf-page {
  padding: 40rpx 28rpx 64rpx;
}
.shelf-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 18rpx 4rpx 14rpx;
}
.shelf-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 600;
}
.checkin-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 10rpx;
  margin: 0;
  padding: 0 20rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
  background: #315c61;
  color: #fff;
  box-shadow: 0 5rpx 12rpx #315c6118;
}
.checkin-button::after {
  border: 0;
}
.checkin-done {
  background: #e4ebe5;
  color: #52716c;
  box-shadow: none;
}
.calendar-icon {
  position: relative;
  width: 29rpx;
  height: 29rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
}
.calendar-icon::before {
  content: '';
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  border-top: 2rpx solid currentColor;
}
.calendar-icon text {
  padding-top: 7rpx;
}
.calendar-dot {
  width: 5rpx;
  height: 5rpx;
  background: currentColor;
  margin-top: 9rpx;
  border-radius: 1rpx;
}
.reward-dot {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #e8bf79;
}
.shelf-section {
  background: #fcfdfb;
  border: 1rpx solid #e1e7e1;
  border-radius: 24rpx;
  padding: 28rpx 22rpx 36rpx;
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 500;
  color: #52716c;
  margin-bottom: 28rpx;
}
.album-progress {
  height: 4rpx;
  background: #e6ebe5;
  border-radius: 2rpx;
  margin-top: 14rpx;
  overflow: hidden;
}
.album-progress view {
  height: 100%;
  background: #78978a;
  min-width: 4rpx;
  border-radius: 2rpx;
}
.shelf-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32rpx 22rpx;
}
.album-entry {
  min-width: 0;
}
.book {
  position: relative;
  height: 280rpx;
  border-radius: 5rpx 18rpx 18rpx 5rpx;
  overflow: hidden;
  box-shadow: 5rpx 8rpx 14rpx #16313b12;
  box-sizing: border-box;
  padding: 22rpx 14rpx 18rpx 24rpx;
}
.palette-book {
  background: #163137;
  color: #e8e0cf;
}
.binding {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: #ffffff20;
}
.cover-top {
  font-size: 12rpx;
  letter-spacing: 1rpx;
  opacity: 0.7;
}
.cover-title {
  font-size: 29rpx;
  line-height: 1.35;
  letter-spacing: 1rpx;
  font-weight: 500;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}
.cover-map {
  position: absolute;
  left: 18rpx;
  right: 10rpx;
  bottom: 38rpx;
  height: 80rpx;
  overflow: hidden;
  border-radius: 4rpx;
}
.cover-map image {
  position: absolute;
  left: 0;
  top: 0;
  width: 500%;
  height: 2000%;
  opacity: 0.85;
}
.cover-bottom {
  position: absolute;
  bottom: 18rpx;
  font-size: 9rpx;
  letter-spacing: 0;
  opacity: 0.65;
}
.album-title {
  font-size: 25rpx;
  margin-top: 16rpx;
  font-weight: 500;
  display: flex;
  justify-content: space-between;
}
.album-title text {
  color: #52716c;
}
.album-note {
  font-size: 20rpx;
  color: #71858a;
  margin-top: 6rpx;
}
.pending-book {
  background: #e0e4e1;
  color: #8c9995;
  box-shadow: none;
}
.pending-book .binding {
  background: #8c999530;
}

.shelf-eyebrow {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #a48548;
  margin: 0 4rpx;
}
.shelf-description {
  font-size: 25rpx;
  line-height: 1.7;
  color: #71858a;
  margin: 0 4rpx 32rpx;
}

.stamp-book{background:#e9e2d2;color:#785d35}.cover-stamp{position:absolute;width:126rpx;height:126rpx;left:28rpx;bottom:40rpx;overflow:hidden;border-radius:50%}.cover-stamp image{position:absolute;left:0;top:0;width:500%;height:2000%;max-width:none}
