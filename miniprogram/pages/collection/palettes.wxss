page{background:#f4f5f3;color:#213e48}button::after{border:0}.collection-page{padding:32rpx 24rpx 48rpx}.page-title{font-size:42rpx;font-weight:600;margin:8rpx 0 40rpx}.muted{font-size:24rpx;color:#71858a;font-weight:400}.map-window{width:100%;padding-top:53.3333%;position:relative;overflow:hidden}.map-sprite{position:absolute;width:500%;height:2000%;max-width:none}.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:8rpx;padding:20rpx 16rpx;font-size:25rpx}.state{font-size:20rpx;color:#52716c;white-space:nowrap}.locked{color:#8a8271}.palette-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.palette-card{min-width:0;background:#fff;overflow:hidden;border-radius:16rpx}.overlay{position:fixed;inset:0;background:#0006;z-index:200;display:flex;align-items:flex-end}.detail{width:100%;box-sizing:border-box;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom))}.detail-heading{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:600;margin-bottom:24rpx}.close{margin:0;width:72rpx;height:72rpx;line-height:66rpx;padding:0;border-radius:50%;font-size:42rpx;background:#eff3f0;color:#52716c}.palette-description{text-align:left;color:#60797d;font-size:25rpx;line-height:1.7;margin:24rpx 8rpx 28rpx}.apply{background:#315c61;color:#fff;font-size:28rpx;border-radius:10rpx}.apply[disabled]{background:#e8eeea;color:#52716c}.unavailable{text-align:center;color:#71858a;font-size:26rpx;padding:20rpx}.error{color:#a84c3e;font-size:25rpx;padding:16rpx 0}

.palette-filter{display:flex;gap:36rpx;border-bottom:1rpx solid #dfe6e0;margin-bottom:28rpx}.filter-choice{margin:0;padding:0 0 20rpx;border-radius:0;background:transparent;font-size:28rpx;line-height:1.5;color:#71858a;position:relative}.filter-choice text{font-size:22rpx;margin-left:10rpx;font-weight:400}.filter-choice.current{color:#315c61;font-weight:600}.filter-choice.current::after{content:"";position:absolute;left:0;right:0;top:auto;bottom:0;height:4rpx;border:0;border-radius:2rpx;background:#315c61}.palette-grid{margin-top:4rpx}

.series-books{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32rpx 20rpx}.series-album{min-width:0}.series-cover{height:280rpx;position:relative;padding:24rpx 14rpx 18rpx 23rpx;box-sizing:border-box;border-radius:4rpx 14rpx 14rpx 4rpx;overflow:hidden;box-shadow:3rpx 5rpx 10rpx #16313b14}.series-binding{position:absolute;top:0;bottom:0;left:10rpx;width:2rpx;background:currentColor;opacity:.2}.series-cover-label{font-size:11rpx;letter-spacing:1rpx;opacity:.7}.series-cover-title{font-size:29rpx;line-height:1.4;margin-top:24rpx;position:relative;z-index:1}.series-cover-map{position:absolute;left:14rpx;right:8rpx;bottom:48rpx}.series-cover-footer{position:absolute;bottom:18rpx;font-size:17rpx;opacity:.8}.series-name{font-size:24rpx;margin-top:16rpx}.series-progress{font-size:20rpx;color:#71858a;margin-top:6rpx}.series-cover-locked{filter:grayscale(1);opacity:.55}.palette-card-locked .map-window{filter:grayscale(1);opacity:.6}.series-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:26rpx;font-size:28rpx;font-weight:500}.series-detail-heading button{margin:0;padding:10rpx 0;background:transparent;color:#52716c;font-size:25rpx;line-height:1.5}

.detail{max-height:90vh;overflow-y:auto}





.detail-static-preview{position:relative;width:100%;height:0;padding-top:53.1481%;border-radius:8rpx;overflow:hidden}

.detail-load-status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#83979e;pointer-events:none}.detail-heading{position:sticky;top:0;z-index:2;background:#fff;padding-bottom:10rpx}
