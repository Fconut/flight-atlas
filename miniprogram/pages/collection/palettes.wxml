<template name="swatch"><view class="map-window" style="background:{{item.colors.background}}"><image class="map-sprite" src="/assets/collection/palettes.jpg" style="left:-{{item.column*100}}%;top:-{{item.row*100}}%" mode="scaleToFill"/></view></template>
<view class="collection-page">
  <view class="page-title">海报配色</view>
  <view class="palette-filter" role="tablist"><button class="filter-choice {{filter==='all'?'current':''}}" data-filter="all" bindtap="filter" role="tab" aria-selected="{{filter==='all'}}">全部配色 <text>{{total}}</text></button><button class="filter-choice {{filter==='owned'?'current':''}}" data-filter="owned" bindtap="filter" role="tab" aria-selected="{{filter==='owned'}}">已拥有 <text>{{ownedCount}}</text></button></view>
  <view wx:if="{{!seriesId}}" class="series-books"><view wx:for="{{series}}" wx:key="id" class="series-album" bindtap="series" data-id="{{item.id}}" role="button" aria-label="{{item.name}}，已拥有{{item.ownedCount}}款"><view class="series-cover {{item.locked?'series-cover-locked':''}}" style="background:{{item.cover.colors.background}};color:{{item.cover.colors.route}}"><view class="series-binding"/><view class="series-cover-label">PALETTE COLLECTION</view><view class="series-cover-title">{{item.name}}</view><view class="series-cover-map"><template is="swatch" data="{{item:item.cover}}"/></view><view class="series-cover-footer">{{item.ownedCount}} / {{item.total}}</view></view><view class="series-name">{{item.name}}</view><view class="series-progress">{{item.locked?'未解锁':'已拥有 '+item.ownedCount+' 款'}}</view></view></view>
  <view wx:else class="series-detail-heading"><button bindtap="backToSeries">‹ 返回系列</button><text>{{seriesName}}</text></view>
  <view wx:if="{{seriesId}}" class="palette-grid"><view wx:for="{{items}}" wx:key="id" class="palette-card {{item.owned?'':'palette-card-locked'}}" data-id="{{item.id}}" bindtap="open" role="button" aria-label="{{item.name}}，{{item.owned?'已拥有':'待解锁'}}"><template is="swatch" data="{{item}}"/><view class="card-bottom"><text>{{item.name}}</text><text class="state {{item.owned?'':'locked'}}">{{item.active?'使用中':item.included?'已添加':item.owned?'已拥有':'待解锁'}}</text></view></view></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
</view>
<view wx:if="{{selected}}" class="overlay" bindtap="close"><view class="detail" catchtap="stop"><view class="detail-heading"><view>{{selected.name}}</view><button class="close" bindtap="close" aria-label="关闭">×</button></view><view class="detail-static-preview" style="background:{{selected.colors.background}}"><view wx:if="{{detailLoading}}" class="detail-load-status" role="status">正在加载高清示例…</view><palette-preview0 wx:if="{{selected.previewPackage==='palette0'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview1 wx:if="{{selected.previewPackage==='palette1'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview2 wx:if="{{selected.previewPackage==='palette2'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview3 wx:if="{{selected.previewPackage==='palette3'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview4 wx:if="{{selected.previewPackage==='palette4'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview5 wx:if="{{selected.previewPackage==='palette5'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview6 wx:if="{{selected.previewPackage==='palette6'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview7 wx:if="{{selected.previewPackage==='palette7'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview8 wx:if="{{selected.previewPackage==='palette8'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/><palette-preview9 wx:if="{{selected.previewPackage==='palette9'}}" src="{{selected.previewPath}}" bindfailed="detailImageError" bindready="detailImageReady" data-id="{{selected.id}}"/></view><view class="palette-description">{{selected.description}}</view><button wx:if="{{selected.owned}}" class="apply" disabled="{{selected.active||(!selected.included&&selected.full)}}" bindtap="toggleIncluded">{{selected.active?'首页使用中':selected.included?'从海报配色移除':selected.full?'海报配色已满（'+capacity+'/'+capacity+'）':'添加到海报配色'}}</button><view wx:if="{{selected.owned&&!selected.included&&selected.full}}" class="example-note">请先在首页海报配色中移除一款</view><view class="unavailable">{{selected.source}}</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view></view>
