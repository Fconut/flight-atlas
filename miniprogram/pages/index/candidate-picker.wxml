<view wx:if="{{candidateOpen}}" class="overlay candidate-overlay" bindtap="closeCandidate"><view class="dialog candidate-dialog" catchtap="stopDialogTap"><view class="dialog-fixed-heading"><view class="dialog-title">{{candidateTitle}}</view><button class="dialog-close-top" bindtap="closeCandidate" aria-label="关闭选择列表">×</button></view><view class="candidate-search"><input placeholder="搜索名称或代码" value="{{candidateQuery}}" bindinput="candidateSearch"/></view><scroll-view scroll-y class="candidate-scroll"><view wx:for="{{candidateItems}}" wx:key="value" class="candidate-option" data-value="{{item.value}}" bindtap="pickCandidate"><view>{{item.label}}</view><text>{{item.detail}}</text></view><view wx:if="{{!candidateItems.length}}" class="muted center">未找到匹配项，可关闭列表后手动填写。</view></scroll-view></view></view>
