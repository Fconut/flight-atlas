<view wx:if="{{recordFiltersOpen && view==='records'}}" class="overlay map-settings-overlay" bindtap="closeRecordFilters"><view class="map-settings-sheet record-filter-sheet" catchtap="stopDialogTap"><view class="map-sheet-heading"><view class="dialog-title">筛选航班</view><button class="map-sheet-close" bindtap="closeRecordFilters" aria-label="取消筛选">×</button></view><scroll-view scroll-y class="map-settings-scroll"><view class="record-filter-scope">筛选仅影响此列表，不改变地图统计范围或机型收藏。</view><view class="record-filter-fields"><view class="filter-field"><view class="form-label">航线</view><picker range="{{filterOptions.route}}" value="{{draftFilterIndices.route}}" data-key="route" bindchange="draftFilter"><view class="filter-sheet-control">{{filterOptions.route[draftFilterIndices.route]}}<text>⌄</text></view></picker></view><view class="filter-field"><view class="form-label">航空公司</view><picker range="{{filterOptions.airline}}" value="{{draftFilterIndices.airline}}" data-key="airline" bindchange="draftFilter"><view class="filter-sheet-control">{{filterOptions.airline[draftFilterIndices.airline]}}<text>⌄</text></view></picker></view><view class="filter-field"><view class="form-label">机型</view><picker range="{{aircraftFilterOptions}}" value="{{draftFilterIndices.aircraft}}" data-key="aircraft" bindchange="draftFilter"><view class="filter-sheet-control">{{aircraftFilterOptions[draftFilterIndices.aircraft]}}<text>⌄</text></view></picker></view><view class="filter-field"><view class="form-label">年份</view><picker range="{{filterOptions.year}}" value="{{draftFilterIndices.year}}" data-key="year" bindchange="draftFilter"><view class="filter-sheet-control">{{filterOptions.year[draftFilterIndices.year]}}<text>⌄</text></view></picker></view><view class="filter-field"><view class="form-label">行程状态</view><picker range="{{statusOptions}}" value="{{draftStatusIndex}}" data-key="status" bindchange="draftFilter"><view class="filter-sheet-control">{{statusOptions[draftStatusIndex]}}<text>⌄</text></view></picker></view></view></scroll-view><view class="map-sheet-footer record-filter-footer"><button bindtap="resetDraftFilters">重置</button><button class="primary" bindtap="applyRecordFilters">查看航班</button></view></view></view>
