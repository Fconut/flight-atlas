<view class="flight-form-body"><view class="manual-route"><airport-input label="出发机场" value="{{form.from}}" data-key="from" bindairportchange="inlineAirportChange"/><view class="inline-route-divider"><button bindtap="swapAirports" aria-label="交换出发和到达">⇅</button></view><airport-input label="到达机场" value="{{form.to}}" data-key="to" bindairportchange="inlineAirportChange"/></view><view class="form-grid"><view class="form-field"><view class="form-label">起飞日期 <text class="required-mark">*</text></view><picker mode="date" value="{{form.date}}" bindchange="datePicked"><view class="form-control">{{form.date||'请选择日期'}} ▾</view></picker></view><view class="form-field"><view class="form-label">当地起飞时间 · 选填</view><picker mode="time" value="{{form.departureTime}}" bindchange="timePicked"><view class="form-control">{{form.departureTime||'选择时间'}} ▾</view></picker><view wx:if="{{form.departureTime}}" class="form-link" bindtap="clearTime">清除时间</view></view></view><view class="form-grid"><view class="form-field"><view class="form-label">航空公司 · 选填</view><input class="form-input" placeholder="航空公司名称或代码" cursor-spacing="72" value="{{form.airline}}" maxlength="50" data-key="airline" bindinput="inlineSuggestionInput"/><view wx:if="{{airlineSuggestions.length}}" class="inline-suggestions"><view wx:for="{{airlineSuggestions}}" wx:key="value" class="inline-suggestion" data-key="airline" data-value="{{item.value}}" bindtap="chooseInlineSuggestion"><view>{{item.label}}</view><text>{{item.detail}}</text></view></view></view><view class="form-field"><view class="form-label">航班号 · 选填</view><input class="form-input" placeholder="如 9192" cursor-spacing="72" value="{{form.flight}}" maxlength="24" data-key="flight" bindinput="field"/></view></view><view class="form-field"><view class="form-label">机型 · 选填</view><input class="form-input" placeholder="如 Airbus A350-900" cursor-spacing="72" value="{{form.aircraft}}" maxlength="100" data-key="aircraft" bindinput="inlineSuggestionInput"/><view wx:if="{{aircraftSuggestions.length}}" class="inline-suggestions"><view wx:for="{{aircraftSuggestions}}" wx:key="value" class="inline-suggestion" data-key="aircraft" data-value="{{item.value}}" bindtap="chooseInlineSuggestion"><view>{{item.label}}</view><text>{{item.detail}}</text></view></view></view><view class="form-note">输入机场名称并点选候选。起飞时间按出发地当地时间填写。</view></view>
