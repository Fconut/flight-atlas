<view wx:if="{{initializing||(savePhase==='loading'&&!rows.length)}}" class="startup-loading" role="status">正在恢复记录…</view><view class="page {{view==='map'?'map-page':''}}"><view class="eyebrow">YOUR PERSONAL FLIGHT ATLAS</view><view class="title">{{view==='map'?'把旅程，绘成一幅地图。':view==='records'?'每一班，都有迹可循。':'每一种飞机，一段新的记忆。'}}</view><view class="muted intro">{{view==='map'?'选择内容、配色与标注，定制你的飞行足迹。':view==='fleet'?'从历史行程中收集你乘坐过的机型。':'搜索、添加或修改航班，地图与统计会同步更新。'}}</view><view wx:if="{{savePhase==='offline'||savePhase==='error'}}" class="save-state save-state-{{savePhase}}" role="status">{{saveStatusText}}</view><view wx:if="{{view==='map'}}" class="map-home">
  <view class="panel preview map-home-preview">
    <view class="preview-head"><view class="section">我的飞行足迹</view><button wx:if="{{hasData}}" class="replay-entry" bindtap="openFlightReplay">航线回放 →</button><text wx:else class="tag">暂无足迹</text></view>
    <view wx:if="{{stampPreviewLoading}}" class="stamp-preview-status" role="status">正在加载印章…</view><view wx:elif="{{stampPreviewError}}" class="stamp-preview-status" role="alert"><text>{{stampPreviewError}}</text><button bindtap="retryStampPreview">重试</button></view>
    <view wx:if="{{!hasData}}" class="empty"><canvas hidden="{{mapSettingsOpen||exportOpen||fleetSelected||recordFiltersOpen||candidateOpen}}" style="display:{{mapSettingsOpen||exportOpen||fleetSelected||recordFiltersOpen||candidateOpen?'none':'block'}}" type="2d" id="empty-atlas" class="empty-map"/><view class="empty-content"><view class="orbit">✦</view><view class="empty-title">{{rows.length?'暂无可展示的航班':'从第一班航班开始'}}</view><view>{{rows.length?'可在下方开启“计入未来行程”，或检查机场和日期。':'导入记录，或手动添加，生成你的飞行足迹。'}}</view><view class="empty-buttons"><button class="primary" data-key="data" bindtap="openMapSettings">＋ 添加航班</button></view></view></view>
    <view wx:else class="poster" style="{{posterPreviewHeight?'height:'+posterPreviewHeight+'px;':''}}" bindtap="exportImage" role="button" aria-label="查看高清飞行地图"><canvas hidden="{{mapSettingsOpen||exportOpen||fleetSelected||recordFiltersOpen||candidateOpen}}" style="{{posterPreviewHeight?'height:'+posterPreviewHeight+'px;':''}}display:{{mapSettingsOpen||exportOpen||fleetSelected||recordFiltersOpen||candidateOpen?'none':'block'}}" type="2d" id="atlas" class="map"/></view>
  </view>
  <view class="map-tools">
    <button data-key="content" bindtap="openMapSettings"><text class="map-tool-icon">▤</text><text>海报内容</text></button>
    <button data-key="colors" bindtap="openMapSettings"><text class="map-tool-icon">◐</text><text>海报装饰</text></button>
    <button data-key="labels" bindtap="openMapSettings"><text class="map-tool-icon">⌖</text><text>机场标注</text></button>
    <button data-key="data" bindtap="openMapSettings"><text class="map-tool-icon">＋</text><text>航班数据</text></button>
  </view>
  <view class="map-scope"><view><view class="map-scope-title">统计范围</view><view class="map-scope-note">{{future?'已计入未来行程':'仅统计已飞行程'}} · {{total}} 班纳入统计</view></view><view class="map-scope-control"><text>计入未来行程</text><switch checked="{{future}}" bindchange="future" color="#315c61" aria-label="计入未来行程"/></view></view>
  <view wx:if="{{hasData}}" class="map-save-bar"><view class="map-primary-actions"><button class="poster-preview-action" bindtap="exportImage" loading="{{exporting}}" disabled="{{exporting||initializing}}">{{exporting?'正在生成…':exportFailed?'重试生成海报':'预览与保存海报'}}</button><button class="primary" bindtap="openSharePreview" disabled="{{exporting||initializing}}">分享给好友</button></view><view wx:if="{{exportFailed}}" class="muted small center" role="status">{{exportMessage}}</view></view>
</view><view wx:elif="{{view==='records'}}" class="panel inside"><view class="section">我的航班记录</view><view class="record-searchbar"><view class="record-searchbox"><input placeholder="搜索机场、城市或航班号" value="{{search}}" bindinput="search" confirm-type="search"/><button wx:if="{{search}}" class="search-clear" bindtap="clearSearch" aria-label="清除搜索">×</button></view><button class="record-filter-trigger {{activeFilterCount?'has-filters':''}}" bindtap="openRecordFilters">筛选{{activeFilterCount?' · '+activeFilterCount:''}}</button></view><view wx:if="{{activeFilterCount}}" class="record-filter-chips"><button wx:for="{{activeFilters}}" wx:key="key" data-key="{{item.key}}" bindtap="removeRecordFilter" aria-label="取消筛选 {{item.label}}"><text>{{item.label}}</text><text>×</text></button><button class="filter-clear-all" bindtap="clearRecordFilters">清空筛选</button></view><view class="muted small">共 {{rows.length}} 条<text wx:if="{{search||activeFilterCount}}"> · 匹配 {{matchCount}} 条</text></view><view class="actions"><button class="primary" bindtap="addFlightPage">＋ 添加航班</button><button data-key="data" bindtap="openMapSettings">导入文件或图片</button></view><view class="record-card" style="background:{{item.cardTheme.background}};border-color:{{item.cardTheme.border}}" wx:for="{{visibleRows}}" wx:key="_id">
  <view class="record-card-heading"><view class="record-airline"><airline-logo code="{{item.airline}}" flight="{{item.flight}}"/></view><text class="record-state {{item.status==='未来行程'?'record-state-future':item.status==='需要修正'?'record-state-invalid':''}}">{{item.status}}</text></view>
  <view class="record-card-main"><view class="record-airport"><view class="record-city">{{item.fromName}}</view><view class="record-code">{{item.from}}</view></view><view class="record-route-arrow" aria-label="飞往">→</view><view class="record-airport record-airport-arrival"><view class="record-city">{{item.toName}}</view><view class="record-code">{{item.to}}</view></view></view>
  <view class="record-card-footer"><view class="record-meta"><view class="record-date">{{item.date}}<text wx:if="{{item.departureTime}}" class="record-time">{{item.departureTime}}</text></view><view class="record-aircraft">{{item.aircraftName}}</view></view><view class="record-actions"><button data-index="{{index}}" bindtap="editFlightPage" aria-label="编辑 {{item.displayFlight}}">编辑</button><button class="record-delete" data-index="{{index}}" bindtap="remove" aria-label="删除 {{item.displayFlight}}">删除</button></view></view>
</view><view wx:if="{{rows.length && !matchCount}}" class="muted center">没有匹配的记录，试试调整搜索或筛选。<button class="record-empty-reset" bindtap="clearRecordConditions">清空搜索与筛选</button></view><view wx:if="{{canUndo}}" class="undo-bar" role="status"><text>已删除 1 条航班</text><button class="undo-action" bindtap="undoRemove">撤销删除</button><button class="undo-dismiss" bindtap="dismissUndo" aria-label="关闭撤销提示">×</button></view><view wx:if="{{pages>1}}" class="records-pagination"><view class="record-page-range">{{pageRange}}</view><view class="record-page-controls"><button class="record-page-arrow" data-step="-1" bindtap="paginate" disabled="{{pageNumber<=1}}" aria-label="上一页">←</button><block wx:for="{{pageChoices}}" wx:key="key"><text wx:if="{{item.gap}}" class="record-page-gap">…</text><button wx:else class="record-page-number {{item.current?'record-page-selected':''}}" data-page="{{item.page}}" bindtap="jumpPage" aria-label="第 {{item.page}} 页">{{item.page}}</button></block><button class="record-page-arrow" data-step="1" bindtap="paginate" disabled="{{pageNumber>=pages}}" aria-label="下一页">→</button></view></view><view wx:if="{{!rows.length}}" class="muted center">还没有航班记录，从第一班开始。</view><view class="record-management"><view class="quality-entry" bindtap="openDataCheck" role="button" aria-label="数据检查"><view><view class="quality-entry-title">数据检查</view><view class="quality-entry-note">日期、机场、机型与疑似重复</view></view><text class="quality-entry-count">{{qualityCount?qualityCount+' 条待核对':'查看检查结果'}} →</text></view><view wx:if="{{rows.length}}" class="delete-all-entry" bindtap="clearAll" role="button" aria-label="删除当前账号全部航班"><view><view class="delete-all-title">删除全部航班</view><view class="delete-all-note">当前账号共 {{rows.length}} 条 · 包含筛选外记录</view></view><text class="delete-all-arrow">›</text></view></view></view><view wx:else class="panel inside"><view class="collection-heading"><view class="section">机型收藏册</view><button wx:if="{{fleetUnlocked}}" class="fleet-detail-share" bindtap="shareCollection" aria-label="分享我的收藏"><view class="share-symbol"><view class="share-link share-link-top"/><view class="share-link share-link-bottom"/><view class="share-dot share-dot-left"/><view class="share-dot share-dot-top"/><view class="share-dot share-dot-bottom"/></view></button></view><view class="muted">已解锁 {{fleetUnlocked}} 枚徽章 · 已记录 {{fleetRecordedTypes}} 种机型 · {{fleetRecordedFlights}} 次飞行</view><view class="fleet-tabs" role="tablist"><view wx:for="{{fleetSections}}" wx:key="maker" role="tab" aria-selected="{{fleetTab===item.maker}}" aria-label="{{item.maker}}，{{item.count}} 次飞行" class="fleet-tab {{fleetTab===item.maker?'fleet-tab-selected':''}}" data-maker="{{item.maker}}" bindtap="selectFleetTab"><view>{{item.maker}}</view><view class="fleet-tab-count">{{item.count}} 次飞行</view></view></view><block wx:for="{{fleetSections}}" wx:key="maker" wx:for-item="section"><view wx:if="{{section.maker===fleetTab||fleetVisited[section.maker]}}" hidden="{{section.maker!==fleetTab}}"><view class="fleet-grid"><view wx:for="{{section.items}}" wx:key="id" class="fleet-card" aria-label="{{item.name}}，{{item.count}} 次飞行" data-id="{{item.id}}" bindtap="fleetSelect"><view class="fleet-art {{item.count?'':'locked-art'}}"><badge-art0 wx:if="{{item.package==='badges0'}}" src="{{item.badge}}" transform="{{item.transform}}"/><badge-art1 wx:if="{{item.package==='badges1'}}" src="{{item.badge}}" transform="{{item.transform}}"/><badge-art2 wx:if="{{item.package==='badges2'}}" src="{{item.badge}}" transform="{{item.transform}}"/><badge-art3 wx:if="{{item.package==='badges3'}}" src="{{item.badge}}" transform="{{item.transform}}"/><badge-art4 wx:if="{{item.package==='badges4'}}" src="{{item.badge}}" transform="{{item.transform}}"/></view><view class="small {{item.badge?'fleet-name-hidden':''}}">{{item.name}}</view><view>{{item.count?item.count+' 次飞行':'未解锁'}}{{item.badge?'':' · 暂无徽章'}}</view><view class="muted small">{{item.first?'首乘 '+item.first:''}}</view></view></view><view wx:if="{{section.unbadged.length}}" class="fleet-unbadged"><view class="fleet-unbadged-heading">已记录机型 · 暂无徽章</view><view wx:for="{{section.unbadged}}" wx:key="id" class="fleet-unbadged-row" data-id="{{item.id}}" bindtap="fleetSelect" role="button" aria-label="{{item.name}}，{{item.count}} 次飞行，查看乘坐记录"><view class="fleet-unbadged-copy"><view class="fleet-unbadged-name">{{item.name}}</view><view class="muted small">首乘 {{item.first}}</view></view><view class="fleet-unbadged-count">{{item.count}} 次<text> ›</text></view></view></view></view></block></view><view class="error" wx:if="{{error}}">{{error}}</view></view><canvas wx:if="{{exporting}}" type="2d" id="export-atlas" class="export-canvas"/><view wx:if="{{fleetSelected}}" class="overlay fleet-detail-overlay" bindtap="closeFleet"><view class="fleet-detail-dialog" catchtap="stopDialogTap">
  <view class="fleet-detail-heading"><view wx:if="{{fleetSelected.badge}}" class="fleet-detail-thumbnail"><badge-art0 wx:if="{{fleetSelected.package==='badges0'}}" src="{{fleetSelected.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art1 wx:if="{{fleetSelected.package==='badges1'}}" src="{{fleetSelected.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art2 wx:if="{{fleetSelected.package==='badges2'}}" src="{{fleetSelected.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art3 wx:if="{{fleetSelected.package==='badges3'}}" src="{{fleetSelected.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/><badge-art4 wx:if="{{fleetSelected.package==='badges4'}}" src="{{fleetSelected.badge}}" size="96" style="display:block;width:96rpx;height:96rpx"/></view><view class="fleet-detail-heading-copy"><view class="dialog-title">{{fleetSelected.name}}</view><text wx:if="{{fleetSelected.first}}" class="fleet-detail-first">首乘 {{fleetSelected.first}}</text></view><view class="fleet-detail-actions {{fleetSelected.badge?'':'fleet-detail-actions-single'}}"><button wx:if="{{fleetSelected.badge}}" class="fleet-detail-share" bindtap="shareBadge" aria-label="分享这枚徽章"><view class="share-symbol"><view class="share-link share-link-top"/><view class="share-link share-link-bottom"/><view class="share-dot share-dot-left"/><view class="share-dot share-dot-top"/><view class="share-dot share-dot-bottom"/></view></button><button class="fleet-detail-close" bindtap="closeFleet" aria-label="关闭机型详情">×</button></view></view>
  <view class="fleet-detail-stats"><view><text class="fleet-detail-number">{{fleetSelected.count}}</text><text class="fleet-detail-label">次飞行</text></view><view><text class="fleet-detail-number">{{fleetSelected.airlineCount}}</text><text class="fleet-detail-label">家航空公司</text></view><view><text class="fleet-detail-number">{{fleetSelected.routeCount}}</text><text class="fleet-detail-label">条单向航线</text></view></view>
  <view class="fleet-detail-list-heading"><text>乘坐记录</text><text>最新在前</text></view>
  <scroll-view scroll-y class="fleet-detail-scroll" enhanced show-scrollbar="{{false}}"><view class="fleet-detail-list"><view class="fleet-detail-flight" wx:for="{{fleetSelected.rows}}" wx:key="_id" style="background:{{item.cardTheme.background}}"><view class="fleet-detail-flight-heading"><view class="fleet-detail-date">{{item.date}}<text wx:if="{{item.departureTime}}">{{item.departureTime}}</text></view><view class="fleet-detail-flight-number"><airline-logo code="{{item.airline}}" flight="{{item.flight}}"/></view></view><view class="fleet-detail-route"><view class="fleet-detail-airport"><view>{{item.fromName}}</view><text>{{item.from}}</text></view><text class="fleet-detail-arrow">→</text><view class="fleet-detail-airport fleet-detail-arrival"><view>{{item.toName}}</view><text>{{item.to}}</text></view></view></view><view class="fleet-detail-bottom-space"/></view></scroll-view>
</view></view><view wx:if="{{exportOpen}}" class="overlay" bindtap="closeExport"><view class="dialog" catchtap="stopDialogTap"><view class="dialog-fixed-heading"><view class="dialog-title">飞行足迹海报</view><button class="dialog-close-top" bindtap="closeExport" aria-label="关闭弹窗">×</button></view><image class="export-preview" src="{{exportPath}}" mode="widthFix" bindtap="previewExport"/><view class="muted small">点击图片查看高清海报</view><view class="muted small" role="status">{{exportMessage}}</view><view class="poster-dialog-actions"><button class="primary" bindtap="saveExport" disabled="{{savingImage}}" loading="{{savingImage}}">保存到手机相册</button><button bindtap="openSharePreview" disabled="{{savingImage}}">分享给好友</button></view></view></view>
<view wx:if="{{clearAllOpen&&view==='records'}}" class="overlay clear-all-overlay" style="padding-bottom:{{clearAllKeyboardHeight}}px;box-sizing:border-box" bindtap="cancelClearAll"><view class="clear-all-dialog" catchtap="stopDialogTap"><view class="clear-all-heading"><view><view class="clear-all-step">第 2 步 / 共 3 步</view><view class="dialog-title">输入文字确认</view></view><button class="clear-all-close" bindtap="cancelClearAll" aria-label="取消全部删除">×</button></view><view class="clear-all-instruction">请在下方输入 <text>全部删除</text> 四个字</view><view class="clear-all-input-shell"><input value="{{clearAllText}}" bindinput="clearAllTextChanged" placeholder="请输入确认文字" maxlength="20" adjust-position="{{false}}" bindkeyboardheightchange="clearAllKeyboardChanged" disabled="{{clearAllFinalizing}}" aria-label="输入全部删除四个字"/></view><view class="clear-all-buttons"><button bindtap="cancelClearAll">取消</button><button class="clear-all-continue" bindtap="confirmClearAllText" disabled="{{clearAllText!=='全部删除'||clearAllFinalizing}}">下一步 · 最后确认</button></view></view></view>
<include src="./map-settings.wxml"/>

<include src="./record-filters.wxml"/>
