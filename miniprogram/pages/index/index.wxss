page {
  background: #f4f5f3;
  color: #213c46;
  font-size: 26rpx;
}
.page {
  padding: 0 28rpx 30rpx;
}
.eyebrow {
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #9c8353;
  margin-bottom: 16rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 500;
}
.muted {
  color: #71858a;
  line-height: 1.8;
}
.intro {
  font-size: 24rpx;
  margin: 16rpx 0 32rpx;
}
.panel {
  background: white;
  border: 1rpx solid #dfe5e1;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}
.inside {
  padding: 32rpx;
}
.section {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.small {
  font-size: 21rpx;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.actions button {
  flex: 1;
}
button {
  font-size: 24rpx;
  border-radius: 10rpx;
  line-height: 1.5;
  padding: 20rpx;
  background: #f5f8f4;
  color: #446e70;
  margin: 0;
}
button:after {
  border: 1rpx solid #dfe5e1;
}
.primary {
  background: #183d46;
  color: #f5e8c9;
}
.preview {
  padding: 26rpx;
}
.preview-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.preview-head .eyebrow {
  font-size: 15rpx;
  margin-bottom: 10rpx;
}
.tag {
  font-size: 20rpx;
  background: #f5f8f4;
  color: #779188;
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
}
.orbit {
  font-size: 65rpx;
  color: #e8bf79;
}
.empty-title {
  color: #eef3f5;
  font-size: 32rpx;
  margin: 24rpx 0;
}
.empty button {
  display: inline-block;
  background: #f2e5c9;
  color: #243c47;
  margin-top: 35rpx;
}
.poster {
  background: #101c2a;
  color: #eef3f5;
}
.map {
  width: 100%;
  height: 235px;
}
.preview > .primary {
  margin-top: 24rpx;
}
.center {
  text-align: center;
  padding-top: 16rpx;
}
.flight {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0eb;
}
.error {
  color: #a55241;
  padding: 20rpx;
  background: #fbf1ed;
}
input {
  background: #f7f9f6;
  border: 1rpx solid #dfe5e1;
  padding: 22rpx;
  margin: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.overlay {
  position: fixed;
  inset: 0;
  background: #0007;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.export-canvas {
  position: fixed;
  left: -10px;
  top: -10px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
.poster .map {
  width: 100%;
  height: calc((100vw - 110rpx) * 1.064814815);
}
.dialog > button {
  margin-top: 20rpx;
}

.label-choice {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0eb;
  font-size: 23rpx;
}
.fleet-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}
.fleet-card image {
  width: 100%;
  height: 230rpx;
}
.badge-placeholder {
  height: 230rpx;
  line-height: 230rpx;
  font-size: 80rpx;
  color: #9c8353;
}
.actions text {
  align-self: center;
  white-space: nowrap;
  font-size: 23rpx;
}

.record-city {
  font-size: 28rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.empty {
  background: #101c2a;
  color: #adbdc7;
  text-align: center;
  border-radius: 6rpx;
  font-size: 22rpx;
  position: relative;
  overflow: hidden;
  padding: 70rpx 20rpx;
}
.empty-map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.empty-content {
  position: relative;
  z-index: 1;
}
.empty-buttons {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}
.empty-buttons button {
  font-size: 22rpx;
  padding: 18rpx;
}
.export-preview {
  display: block;
  width: 100%;
  border-radius: 6rpx;
}
.fleet-card {
  text-align: center;
  border-radius: 14rpx;
  font-size: 23rpx;
  background: transparent;
  padding: 0;
  position: relative;
}
.fleet-art {
  width: 100%;
  filter: drop-shadow(0 6rpx 5rpx #76562825);
}
.locked-art {
  filter: grayscale(1);
  opacity: 0.5;
}
.fleet-name-hidden {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
/* Flight data panel mirrors the web workspace hierarchy. */
.data-panel {
  padding: 36rpx 34rpx 16rpx;
}

.data-drop {
  min-height: 360rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccd9d3;
  border-radius: 16rpx;
  background: #f6f9f5;
  padding: 36rpx 16rpx;
  gap: 20rpx;
}
.data-upload-icon {
  font-size: 76rpx;
  font-weight: 300;
  color: #77928b;
  line-height: 1.1;
  margin-bottom: 8rpx;
}
.data-upload-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #213c46;
}
.data-upload-formats,
.data-upload-limit {
  font-size: 24rpx;
  line-height: 1.7;
  color: #92a0a4;
}
.data-upload-limit {
  margin-top: 8rpx;
}
.data-file-name {
  font-size: 25rpx;
  line-height: 1.8;
  color: #879794;
  margin: 28rpx 0 24rpx;
  overflow-wrap: anywhere;
}
.data-help {
  border-top: 1rpx solid #e7ece7;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
}
.data-file-name + .data-help {
  margin-top: 0;
}
.data-help-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: #71858a;
  line-height: 1.5;
}
.data-help-content {
  font-size: 23rpx;
  line-height: 1.9;
  color: #71858a;
  padding-bottom: 20rpx;
}
.data-help-content > view {
  margin-bottom: 16rpx;
}
.data-template {
  display: block;
  background: transparent;
  color: #446e70;
  padding: 12rpx 0;
  text-align: left;
  font-size: 24rpx;
}
.data-template:after {
  border: 0;
}
.data-add {
  width: 100%;
  box-sizing: border-box;
  background: white;
  border: 2rpx solid #d6dfe0;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  color: #345666;
  line-height: 1.5;
}
.data-add:after {
  border: 0;
}
.data-manage {
  font-size: 26rpx;
  color: #446e70;
  line-height: 1.7;
  padding: 28rpx 0 12rpx;
}




/* Flight cards: identity, directional route, then compact details and actions. */
.record-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e0e7e1;
  border-radius: 18rpx;
  background: #fbfcfa;
}
.record-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.record-airline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #355760;
}
.record-airline text { overflow-wrap: anywhere; }

.record-card-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 0 22rpx;
}
.record-airport { flex: 1; min-width: 0; }
.record-airport-arrival { text-align: right; }
.record-card .record-city {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #213c46;
  overflow-wrap: anywhere;
}
.record-code {
  margin-top: 4rpx;
  color: #668186;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.4;
}
.record-route-arrow {
  flex: 0 0 48rpx;
  text-align: center;
  color: #98aaa2;
  font-size: 38rpx;
  line-height: 1;
}
.record-card-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e5eae4;
}
.record-meta { flex: 1; min-width: 0; }
.record-date {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #526e76;
}
.record-time { font-weight: 600; color: #355760; }
.record-aircraft {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #82938e;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.record-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.record-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: #e9f0e9;
  color: #315c61;
  margin: 0;
}
.record-actions button:after { border: 0; }
.record-actions .record-delete { color: #a16959; background: transparent; }
.record-state {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1.5;
  padding: 5rpx 12rpx;
  background: #edf2ec;
  color: #748b80;
  border-radius: 8rpx;
}
.record-state-future { background: #eaf0f5; color: #6d8495; }
.record-state-invalid { background: #fbebe5; color: #a16959; }
.records-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0 12rpx;
}
.record-page-range {
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a999e;
  white-space: nowrap;
}
.record-page-controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
}
.record-page-controls button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  min-width: 52rpx;
  height: 58rpx;
  border-radius: 8rpx;
  background: #f5f8f4;
  color: #688185;
  font-size: 23rpx;
  line-height: 1;
}
.record-page-controls button:after {
  border: 1rpx solid #e1e7e2;
}
.record-page-controls .record-page-selected {
  background: #183d46;
  color: white;
}
.record-page-controls .record-page-selected:after {
  border-color: #183d46;
}
.record-page-controls button[disabled] {
  color: #c4ccca;
  background: #f7f8f7;
}
.record-page-gap {
  font-size: 23rpx;
  color: #8a999e;
  padding: 0 4rpx;
}
.record-searchbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 0;
}
.record-searchbox {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: #f7f9f6;
  border: 1rpx solid #dfe5e1;
  border-radius: 12rpx;
  padding: 0 18rpx;
}
.record-searchbox input {
  flex: 1;
  width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 24rpx;
}
.record-searchbox .search-clear {
  padding: 0;
  width: 56rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 34rpx;
  flex-shrink: 0;
  background: transparent;
  color: #82958f;
}
.search-clear:after {
  border: 0;
}
.record-filter-trigger {
  flex-shrink: 0;
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  background: #f7f9f6;
  font-size: 25rpx;
}
.record-filter-trigger.has-filters {
  color: #fff;
  background: #315c61;
}
.record-filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -4rpx 0 20rpx;
}
.record-filter-chips button {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  max-width: 100%;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  background: #edf4ee;
}
.record-filter-chips button text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-filter-chips button text:last-child {
  flex-shrink: 0;
}
.record-filter-chips .filter-clear-all {
  background: transparent;
  color: #71858a;
}
.filter-clear-all:after {
  border: 0;
}
.record-filter-fields {
  padding: 28rpx;
}
.filter-field {
  margin-bottom: 24rpx;
}
.filter-sheet-control {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #dfe5e1;
  border-radius: 10rpx;
  background: #f7f9f6;
  color: #31535c;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.filter-sheet-control text {
  flex-shrink: 0;
  color: #82958f;
}
.record-filter-footer {
  display: flex;
  gap: 16rpx;
}
.record-filter-footer > button {
  flex: 1;
}
.record-filter-footer > .primary {
  flex: 2;
}

.fleet-tabs {
  display: flex;
  gap: 8rpx;
  border-bottom: 1rpx solid #dfe5e1;
  margin-top: 28rpx;
  background: #f8faf8;
}
.fleet-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  font-size: 26rpx;
  color: #8a999b;
  border-bottom: 4rpx solid transparent;
}
.fleet-tab-count {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 400;
}
.fleet-tab-selected {
  color: #21474d;
  border-bottom-color: #315c61;
  font-weight: 600;
}
.fleet-tabs + .fleet-grid {
  margin-top: 24rpx;
}
.dialog {
  background: #fff;
  padding: 36rpx;
  width: 82%;
  border-radius: 20rpx;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding-top: 0;
  position: relative;
  overscroll-behavior: contain;
}
.dialog-fixed-heading {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #fff;
  padding: 26rpx 0 22rpx;
  margin-bottom: 18rpx;
  border-bottom: 1rpx solid #e4eae5;
}
.dialog-title {
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #213c46;
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.dialog-fixed-heading .dialog-close-top {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  background: #f1f5f2;
  border-radius: 50%;
  font-size: 44rpx;
  line-height: 1;
  color: #44646b;
}
.dialog-close-top:after {
  border: 0;
}
.flight-form-body {
  padding: 24rpx 28rpx 12rpx;
}
.form-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20rpx;
}
.form-field {
  min-width: 0;
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 23rpx;
  color: #526e73;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.required-mark {
  color: #ac7256;
}
.form-control {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe5e1;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #213c46;
  font-size: 25rpx;
  margin: 0;
  line-height: normal;
}
.form-link {
  padding: 12rpx 0 0;
  color: #446e70;
  font-size: 22rpx;
  line-height: 1.5;
}
.form-swap {
  text-align: right;
  margin: -10rpx 0 24rpx;
  padding: 0;
}
.form-note {
  color: #8a9c94;
  font-size: 21rpx;
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.form-footer-buttons {
  display: flex;
  gap: 16rpx;
}
.form-footer-buttons button {
  margin: 0;
  flex: 1;
  padding: 22rpx 12rpx;
  font-size: 25rpx;
}
.form-footer-buttons .primary {
  flex: 2;
}
.form-error {
  font-size: 23rpx;
  color: #a55241;
  line-height: 1.5;
  max-height: 110rpx;
  overflow-y: auto;
  margin-bottom: 16rpx;
}

.candidate-overlay {
  z-index: 30;
}
.candidate-dialog {
  width: 90%;
  padding: 0 28rpx 24rpx;
  overflow: hidden;
}
.candidate-dialog .dialog-fixed-heading {
  margin-bottom: 0;
}
.candidate-search input {
  margin: 14rpx 0 20rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
}
.candidate-scroll {
  height: 48vh;
}
.candidate-option {
  padding: 22rpx 6rpx;
  border-bottom: 1rpx solid #e5ebe6;
  color: #213c46;
  font-size: 27rpx;
  line-height: 1.5;
}
.candidate-option text {
  font-size: 22rpx;
  color: #879b98;
}

.startup-loading {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: #f4f5f3;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #71858a;
  font-size: 28rpx;
}

/* Native tabs handle the safe area; keep map actions in normal flow without a reserved gap. */
.map-page {
  padding: 8rpx 16rpx 16rpx;
}
.map-page > .eyebrow,
.map-page > .title,
.map-page > .intro {
  margin-left: 12rpx;
  margin-right: 12rpx;
}
.save-state {
  font-size: 21rpx;
  line-height: 1.6;
  color: #82938e;
  margin: 8rpx 0 12rpx;
}
.save-state-offline,
.save-state-error {
  color: #a16d40;
}
.map-home-preview {
  padding: 12rpx;
  margin-bottom: 14rpx;
}
.map-home-preview .preview-head {
  padding: 6rpx 6rpx 12rpx;
  margin-bottom: 0;
}
.map-home-preview .section {
  font-size: 32rpx;
  margin-bottom: 0;
}
.map-home-preview .poster {
  /* Keep the page height stable when a native canvas is hidden behind a modal. */
  height: calc((100vw - 58rpx) * 1.064814815);
  border-radius: 10rpx;
  overflow: hidden;
  width: 100%;
  margin: 0 auto;
}
.map-home-preview .poster .map {
  height: calc((100vw - 58rpx) * 1.064814815);
}
.map-home-preview .empty {
  padding: 60rpx 20rpx;
}
.map-tools {
  display: flex;
  gap: 14rpx;
}
.map-tools button {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  font-size: 23rpx;
  padding: 18rpx 8rpx;
  gap: 8rpx;
}
.map-tool-icon {
  display: block;
  font-size: 36rpx;
  line-height: 1;
  color: #315c61;
}
.map-context {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  font-size: 21rpx;
  color: #82938e;
  padding: 20rpx 4rpx;
  line-height: 1.6;
}
.map-save-bar {
  padding: 12rpx 0 0;
  background: #f4f5f3;
  border-top: 1rpx solid #e2e7e2;
  z-index: 2;
}
.map-save-bar .primary {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  padding: 22rpx 18rpx;
}
.map-save-bar .center {
  padding-top: 10rpx;
  font-size: 20rpx;
}
.map-settings-overlay {
  align-items: flex-end;
  z-index: 12;
}
.map-settings-sheet {
  width: 100%;
  height: 76vh;
  max-height: calc(100vh - 70rpx);
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  box-sizing: border-box;
}
.map-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #e4eae5;
  flex-shrink: 0;
}
.map-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  flex-shrink: 0;
  font-size: 44rpx;
  border-radius: 50%;
}
.map-sheet-close:after {
  border: 0;
}
.map-settings-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.map-sheet-footer {
  padding: 16rpx 28rpx 20rpx;
  border-top: 1rpx solid #e4eae5;
  flex-shrink: 0;
}
.map-sheet-footer button {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
}
.map-settings-sheet .data-panel {
  padding-top: 22rpx;
}

.map-settings-sheet .data-drop {
  min-height: 220rpx;
  gap: 10rpx;
  padding: 24rpx 16rpx;
}
.map-settings-sheet .data-upload-icon {
  font-size: 48rpx;
  margin-bottom: 0;
}
.map-settings-sheet .data-upload-title {
  font-size: 28rpx;
}
.map-settings-sheet .data-file-name {
  margin: 18rpx 0;
}
.map-settings-sheet .data-help-toggle {
  padding: 22rpx 0;
}

.map-settings-sheet .inside > .section {
  margin-bottom: 12rpx;
}

