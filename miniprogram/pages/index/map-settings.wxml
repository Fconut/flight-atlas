<view wx:if="{{mapSettingsOpen && (view==='map'||(view==='records'&&setting==='data'))}}" class="overlay map-settings-overlay" bindtap="closeMapSettings">
  <view class="map-settings-sheet" catchtap="stopDialogTap">
    <view class="map-sheet-heading"><view><view class="dialog-title">{{mapSettingsTitle}}</view><view wx:if="{{setting!=='data'}}" class="muted small">设置自动保存</view></view><button class="map-sheet-close" bindtap="closeMapSettings" aria-label="关闭设置">×</button></view>
    <scroll-view scroll-y class="map-settings-scroll" enhanced show-scrollbar="{{false}}"><view wx:if="{{setting==='data'}}" class="data-settings"><view class="data-panel"><view class="data-drop" bindtap="importFile" role="button" aria-label="选择 Excel、CSV 或航班图片"><view class="data-upload-icon">↥</view><view class="data-upload-title">选择文件或图片</view><view class="data-upload-formats">Excel / CSV · 航班截图</view><view class="data-upload-limit">最大 20 MB</view></view><view wx:if="{{fileName||rows.length}}" class="data-file-name">{{fileName||'共 '+rows.length+' 条航班记录'}}</view><view class="ai-guide-entry" bindtap="openAiImportGuide" role="button"><view><view class="ai-guide-title">用提示词整理航班截图</view><view class="ai-guide-note">复制提示词，制作可导入的 Excel</view></view><text class="ai-guide-arrow">→</text></view><button class="data-add" bindtap="addFlightPage">＋ 手动添加一班</button><view class="data-manage" data-key="records" bindtap="nav" role="button">查看全部航班 →</view><view class="data-help"><view class="data-help-toggle" bindtap="toggleImportHelp" role="button" aria-expanded="{{importHelpOpen}}"><text>文件格式与导入规则</text><text>{{importHelpOpen?'－':'＋'}}</text></view><view wx:if="{{importHelpOpen}}" class="data-help-content">
<view><view class="data-help-title">支持的文件</view><view>Flighty CSV、Excel（.xlsx / .xls），以及航班截图；单个文件最大 20 MB。截图建议使用清晰的 PNG / JPG 图片。</view></view>
<view><view class="data-help-title">表格怎么准备</view><view>至少填写日期、出发机场和到达机场，机场使用三字码（如 SHA、NRT）。建议同时填写航司、航班号；起飞时间和机型可选。支持常见中英文列名，也可使用下方模板。</view></view>
<view><view class="data-help-title">截图怎么导入</view><view>支持历史行程列表和航班详情截图。识别后先核对日期、航班与起降方向，红框字段需修改，也可取消勾选该航班；有多个机场候选时请手动选择。列表中未单独显示日期的航班沿用上方最近的完整日期，截图首条缺失日期时需补填。机型仅按图片中显示的信息读取。</view><view class="data-help-note">单次最多核对 100 条航班，内容过多请分批截图。</view></view>
<view><view class="data-help-title">新增、去重与更新</view><view>导入会追加到现有记录。日期、航司、航班号及起降机场都相同的记录会合并；新文件中非空的机型和起飞时间会更新已有记录，空值不会清除原信息。导入前可核对新增、更新和重复记录，并选择需要导入的航班。</view></view>
<button class="data-template" data-key="template" bindtap="downloadTemplate">下载空白 Excel 模板 ↓</button></view></view></view></view><view class="inside" wx:elif="{{setting==='colors'}}"><view class="palette-toolbar"><view><view class="palette-count">海报配色 · 已添加 {{presets.length}} / {{paletteCapacity||6}}</view><view class="palette-subtitle">{{paletteManaging?'移除后仍保留在收藏中':'选择一款，应用到首页海报'}}</view></view><button class="palette-manage" bindtap="managePosterPalettes">{{paletteManaging?'完成':'管理'}}</button></view><view class="palette-slots"><view class="palette-slot {{selectedColor===item.background+'|'+item.route?'palette-slot-current':''}}" wx:for="{{presets}}" wx:key="id"><button class="palette-choice" style="background:{{item.background}};color:{{item.route}}" data-index="{{index}}" bindtap="preset" disabled="{{paletteManaging}}"><view class="palette-choice-name">{{item.name}}</view><view class="palette-current-label" wx:if="{{selectedColor===item.background+'|'+item.route}}">使用中</view></button><button wx:if="{{paletteManaging&&selectedColor!==item.background+'|'+item.route}}" class="palette-remove" data-id="{{item.id}}" bindtap="removePosterPalette" aria-label="移除{{item.name}}">×</button></view></view><view class="palette-capacity-note" wx:if="{{presets.length>=paletteCapacity}}">配色位已满，请先在管理中移除一款。</view><button class="palette-explore" bindtap="openCollection">{{presets.length>=paletteCapacity?'浏览配色收藏 →':'从收藏添加配色 ＋'}}</button><view wx:if="{{colorNote}}" class="muted small">{{colorNote}}</view><view class="stamp-settings"><view class="palette-toolbar"><view><view class="palette-count">旅途印章 · 已添加 {{stampPresets.length}} / {{stampCapacity||6}}</view><view class="palette-subtitle">每张海报可使用 1 枚印章</view></view><view class="stamp-toolbar-actions"><button class="stamp-none {{!posterStamp?'stamp-none-current':''}}" bindtap="choosePosterStamp" disabled="{{stampManaging}}">{{posterStamp?'不使用印章':'✓ 不使用印章'}}</button><button wx:if="{{stampPresets.length}}" class="palette-manage" bindtap="managePosterStamps">{{stampManaging?'完成':'管理'}}</button></view></view><view wx:if="{{stampPresets.length}}" class="stamp-choices"><view wx:for="{{stampPresets}}" wx:key="id" class="stamp-choice {{posterStamp===item.id?'stamp-choice-current':''}}"><view class="stamp-pick" data-id="{{item.id}}" bindtap="choosePosterStamp" role="button"><view class="stamp-mini"><image src="/assets/collection/stamps.jpg" style="left:-{{item.column*100}}%;top:-{{item.row*100}}%" mode="scaleToFill"/></view><view class="stamp-choice-name">{{item.name}}</view><view wx:if="{{posterStamp===item.id}}" class="stamp-current">使用中</view></view><button wx:if="{{stampManaging&&posterStamp!==item.id}}" class="stamp-remove" data-id="{{item.id}}" bindtap="removePosterStamp" aria-label="移除{{item.name}}">×</button></view></view><button class="palette-explore" bindtap="openStampCollection">{{stampPresets.length>=stampCapacity?'浏览印章收藏 →':'从收藏添加印章 ＋'}}</button></view></view><view class="inside poster-content-settings" wx:elif="{{setting==='content'}}"><view class="content-settings-head"><view><view class="content-mode">{{posterContentCustom?'自定义内容':'默认内容'}}</view><view class="content-selection-count">已选 {{posterContentCount}} 项 · 自动排版</view></view><button class="content-reset" bindtap="resetPosterContent" disabled="{{!posterContentCustom&&posterTitle==='我的足迹'}}">恢复默认</button></view><view class="poster-title-setting"><view class="poster-title-heading"><text>统计区标题</text><text class="poster-title-count">{{posterTitleLength}} / 20</text></view><input class="poster-title-input" value="{{posterTitleDraft}}" placeholder="我的足迹" maxlength="40" bindinput="posterTitleInput" bindblur="posterTitleBlur" confirm-type="done" aria-label="海报统计区标题"/><view class="poster-title-hint">最多20字，留空使用默认标题。</view><view wx:if="{{posterTitleError}}" class="poster-title-error">{{posterTitleError}}</view></view><checkbox-group bindchange="choosePosterContent"><view class="content-group" wx:for="{{posterContentGroups}}" wx:for-item="group" wx:key="id"><view class="content-group-title">{{group.title}}</view><view class="content-options-grid"><label class="content-option {{item.checked?'content-option-selected':''}}" wx:for="{{group.items}}" wx:key="id"><view class="content-option-top"><text class="content-option-label">{{item.label}}</text><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#315c61"/></view><view class="content-option-rule">{{item.rule.note}}</view><view class="content-option-preview {{item.group==='routes'?'content-option-preview-route':''}}">{{item.preview}}</view></label></view></view></checkbox-group><view class="muted small" wx:if="{{posterContentCustom&&!posterContentCount}}">仅展示地图，不显示标题和统计数据。</view></view><view class="inside" wx:else><view class="muted small">标注方式：{{labelModeName||'推荐'}}</view><view class="muted small">已标注 {{labelCount||0}} / {{labelTotal||0}} 个航点</view><view class="actions"><button data-key="all" bindtap="labelMode">全部标注</button><button data-key="none" bindtap="labelMode">全部取消</button><button data-key="auto" bindtap="labelMode">恢复推荐</button></view><input placeholder="搜索起降机场" value="{{labelQuery}}" bindinput="labelSearch"/><checkbox-group bindchange="chooseLabels"><label class="label-choice" wx:for="{{labelOptions}}" wx:key="code"><checkbox value="{{item.code}}" checked="{{item.checked}}" color="#315c61"/><text>{{item.name}} {{item.code}} · {{item.count}} 次起降</text></label></checkbox-group><view wx:if="{{!labelOptions.length}}" class="muted small">{{hasData?'未找到匹配的起降机场':'添加或导入航班后，即可选择标注'}}</view></view></scroll-view>
    <view class="map-sheet-footer"><button class="primary" bindtap="closeMapSettings">{{view==='map'?'完成 · 查看地图':'完成'}}</button></view>
  </view>
</view>
