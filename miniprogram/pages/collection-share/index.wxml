<view class="page"><view class="title">机型收藏册</view><view wx:if="{{loading}}" class="note">正在加载收藏册…</view><view wx:if="{{snapshot}}"><view class="summary">已解锁 {{snapshot.summary.unlocked}} 枚徽章 · 已记录 {{snapshot.summary.types}} 种机型 · {{snapshot.summary.flights}} 次飞行</view><view class="makers" role="tablist"><view wx:for="{{snapshot.summary.makers}}" wx:key="name" data-index="{{index}}" bindtap="selectMaker" role="tab" aria-selected="{{makerIndex===index}}" class="maker {{makerIndex===index?'maker-selected':''}}">{{item.name}}<text>{{item.count}} 次飞行</text></view></view><view class="grid"><view class="badge" wx:for="{{visibleBadges}}" wx:key="id"><badge-art0 style="display:block;width:100%;height:230rpx" wx:if="{{item.package==='badges0'}}" src="{{item.badge}}"/><badge-art1 style="display:block;width:100%;height:230rpx" wx:if="{{item.package==='badges1'}}" src="{{item.badge}}"/><badge-art2 style="display:block;width:100%;height:230rpx" wx:if="{{item.package==='badges2'}}" src="{{item.badge}}"/><badge-art3 style="display:block;width:100%;height:230rpx" wx:if="{{item.package==='badges3'}}" src="{{item.badge}}"/><badge-art4 style="display:block;width:100%;height:230rpx" wx:if="{{item.package==='badges4'}}" src="{{item.badge}}"/><view class="note">{{item.count}} 次飞行</view></view></view></view><view wx:if="{{snapshot&&!visibleBadges.length}}" class="empty">这个分类还没有已解锁徽章</view><view wx:if="{{message}}" class="message" role="alert">{{message}}</view><button wx:if="{{loadError}}" bindtap="load">重新加载</button><view wx:if="{{snapshot&&!loadError}}" class="actions"><button wx:if="{{!public}}" bindtap="prepare" loading="{{busy}}" disabled="{{busy||loading}}">准备分享收藏</button><button wx:if="{{public}}" bindtap="makeMine">制作我的收藏册 →</button></view></view>