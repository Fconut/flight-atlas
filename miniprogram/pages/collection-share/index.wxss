page{background:#fff;color:#213c46}.page{padding:28rpx 26rpx calc(160rpx + env(safe-area-inset-bottom))}.title{font-size:30rpx;font-weight:600;margin:6rpx 0 30rpx}.summary{font-size:23rpx;color:#71858a;line-height:1.8;margin-bottom:28rpx}.makers{display:flex;background:#f7f9f6;margin:0 0 24rpx}.maker{flex:1;text-align:center;font-size:27rpx;color:#8b9ca0;padding:22rpx 4rpx 18rpx;border-bottom:4rpx solid transparent}.maker text{display:block;font-size:22rpx;margin-top:8rpx}.maker-selected{color:#315c61;border-bottom-color:#315c61;font-weight:600}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:28rpx;row-gap:22rpx}.badge{text-align:center;min-width:0;padding:10rpx 0}.note{font-size:24rpx;color:#577780;line-height:1.7;margin:10rpx 0}.message,.empty{font-size:24rpx;color:#82958d;margin:28rpx 0;line-height:1.7}.empty{text-align:center;padding:40rpx 0}.actions{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;background:#fff;border-top:1rpx solid #e2e8e1;padding:16rpx 26rpx calc(20rpx + env(safe-area-inset-bottom))}button{background:#315c61;color:white;font-size:28rpx}.actions button{flex:1;margin:0}
.message{position:fixed;left:26rpx;right:26rpx;bottom:calc(126rpx + env(safe-area-inset-bottom));z-index:20;margin:0;padding:20rpx 24rpx;background:#fff5e9;border:1rpx solid #ead8bf;border-radius:12rpx;color:#8d6038;font-size:25rpx;line-height:1.6;box-shadow:0 6rpx 22rpx rgba(38,62,52,.08)}
