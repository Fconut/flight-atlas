<template name="thumb"><view class="stamp-thumb"><image src="/assets/collection/stamps.jpg" style="left:-{{item.column*100}}%;top:-{{item.row*100}}%" mode="scaleToFill"/></view></template>
<view class="collection-page"><view class="page-title">旅途印章</view><view class="palette-filter"><button class="filter-choice {{filter==='all'?'current':''}}" data-filter="all" bindtap="filter">全部印章 <text>{{total}}</text></button><button class="filter-choice {{filter==='owned'?'current':''}}" data-filter="owned" bindtap="filter">已拥有 <text>{{ownedCount}}</text></button></view>
<view wx:if="{{!seriesId}}" class="series-books"><view wx:for="{{series}}" wx:key="id" class="series-album" bindtap="series" data-id="{{item.id}}" role="button"><view class="series-cover stamp-cover {{item.locked?'series-cover-locked':''}}"><view class="series-binding"/><view class="series-cover-label">TRAVEL STAMPS</view><view class="series-cover-title">{{item.name}}</view><view class="stamp-book-art"><template is="thumb" data="{{item:item.cover}}"/></view><view class="series-cover-footer">{{item.ownedCount}} / {{item.total}}</view></view><view class="series-name">{{item.name}}</view><view class="series-progress">{{item.locked?'未解锁':'已拥有 '+item.ownedCount+' 枚'}}</view></view></view>
<view wx:else><view class="series-detail-heading"><button bindtap="backToSeries">‹ 返回系列</button><text>{{seriesName}}</text></view><view class="palette-grid"><view wx:for="{{items}}" wx:key="id" class="palette-card {{item.owned?'':'stamp-locked'}}" data-id="{{item.id}}" bindtap="open" role="button"><view class="stamp-card-art"><stamp-preview0 wx:if="{{item.previewPackage==='stamps0'}}" stamp-id="{{item.id}}"/><stamp-preview1 wx:elif="{{item.previewPackage==='stamps1'}}" stamp-id="{{item.id}}"/><stamp-preview2 wx:elif="{{item.previewPackage==='stamps2'}}" stamp-id="{{item.id}}"/><stamp-preview3 wx:else stamp-id="{{item.id}}"/></view><view class="card-bottom"><text>{{item.name}}</text><text class="state">{{item.active?'使用中':item.included?'已添加':item.owned?'已拥有':'待解锁'}}</text></view></view></view><view wx:if="{{!items.length}}" class="unavailable">这个系列暂未拥有印章</view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
<view wx:if="{{selected}}" class="overlay" bindtap="close"><view class="detail" catchtap="stop"><view class="detail-heading"><view>{{selected.name}}</view><button class="close" bindtap="close" aria-label="关闭">×</button></view><view class="stamp-detail-art"><view wx:if="{{detailLoading}}" class="detail-load-status">正在加载印章…</view><stamp-preview0 wx:if="{{selected.previewPackage==='stamps0'}}" stamp-id="{{selected.id}}" data-id="{{selected.id}}" bindready="detailReady" bindfailed="detailError"/><stamp-preview1 wx:elif="{{selected.previewPackage==='stamps1'}}" stamp-id="{{selected.id}}" data-id="{{selected.id}}" bindready="detailReady" bindfailed="detailError"/><stamp-preview2 wx:elif="{{selected.previewPackage==='stamps2'}}" stamp-id="{{selected.id}}" data-id="{{selected.id}}" bindready="detailReady" bindfailed="detailError"/><stamp-preview3 wx:else stamp-id="{{selected.id}}" data-id="{{selected.id}}" bindready="detailReady" bindfailed="detailError"/></view><view class="palette-description">{{selected.description}}</view><button wx:if="{{selected.owned}}" class="apply" bindtap="toggleIncluded" disabled="{{selected.active||(!selected.included&&selected.full)}}">{{selected.active?'首页使用中':selected.included?'从海报印章移除':selected.full?'海报印章已满（6/6）':'添加到海报印章'}}</button><view class="unavailable">{{selected.source}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view></view>
