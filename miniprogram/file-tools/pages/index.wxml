<view class="page"><view>{{message}}</view><button wx:if="{{action==='import'}}" bindtap="choose" disabled="{{processing}}" loading="{{processing}}">选择航班文件</button><button wx:if="{{filePath}}" bindtap="shareAgain" disabled="{{sharing}}" loading="{{sharing}}">发送 Excel 文件</button><button wx:if="{{action==='export'&&exportFailed}}" bindtap="retryExport" disabled="{{processing||sharing}}" loading="{{processing}}">重试生成模板</button><button wx:if="{{canRetryImport}}" bindtap="retryImport" disabled="{{processing}}">重试保存已解析的航班</button></view>